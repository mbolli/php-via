{
    "name": "mbolli/php-via",
    "description": "Real-time engine for building reactive web applications in PHP",
    "type": "library",
    "require": {
        "php": "^8.4",
        "ext-openswoole": "^26.0",
        "starfederation/datastar-php": "^1.0",
        "twig/twig": "^3.0",
        "psr/http-server-middleware": "^1.0",
        "nyholm/psr7": "^1.8",
        "openswoole/core": "^26.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1.0",
        "friendsofphp/php-cs-fixer": "^3.90.0",
        "tomasvotruba/type-coverage": "^2.3",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "pestphp/pest": "^5.0",
        "openswoole/ide-helper": "^26.2"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Mbolli\\PhpVia\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Michael Bolli",
            "email": "michael@bolli.us"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "suggest": {
        "ext-brotli": "Brotli level 11 for static files as soon as it is loaded (compressed before the server listens), and for pages and SSE streams with Config::withBrotli()"
    },
    "config": {
        "process-timeout": 0,
        "optimize-autoloader": true,
        "classmap-authoritative": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "dev": "bash scripts/dev.sh",
        "test": "vendor/bin/pest",
        "watch-test": "find src tests -name '*.php' | entr -c vendor/bin/pest",
        "css": "cd website && pnpm build",
        "phpstan": "phpstan analyse --configuration=.phpstan.neon",
        "cs-fix": "php-cs-fixer fix -v --config=.php-cs-fixer.php"
    }
}
