parameters:
  # Per checkout: a cache shared through /tmp mixes results between worktrees.
  tmpDir: .phpstan-cache
  bootstrapFiles:
    - phpstan-bootstrap.php
    - website/vendor/autoload.php
  dynamicConstantNames:
    - SWOOLE_EVENT_READ
    - SWOOLE_IPC_NONE
  level: 6
  scanFiles:
    # The extension's Event methods default to Event::EVENT_READ, a constant the class lacks,
    # which crashes PHPStan when it reflects the loaded extension. The stub takes precedence.
    - vendor/openswoole/ide-helper/src/OpenSwoole/Event.php
  paths:
    - src/
  ignoreErrors:
    # The extension declares Timer::clear() and Timer::exists() without parameters,
    # but both take the timer ID at runtime.
    - message: '#Timer::(clear|exists)\(\)#'
      identifier: arguments.count
  editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'
  editorUrlTitle: '%%file%%:%%line%%'
  type_perfect:
    null_over_false: true
    no_mixed: true
    #narrow_param: true
    #narrow_return: true
  type_coverage:
    declare: 100
    return: 100
    param: 100
    property: 100
    constant: 100
includes:
  - vendor/phpstan/phpstan/conf/bleedingEdge.neon
