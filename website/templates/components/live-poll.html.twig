<div class="demo-box" id="poll-demo">
    <div class="demo-box-label"><span class="live-dot" aria-hidden="true"></span> Scope poll</div>
    <p class="poll-question">Which php-via scope is your favorite?</p>
    {% for option in options %}
    <div class="poll-option" id="poll-option-{{ option.key }}">
        <button class="poll-vote-btn" data-on:click="@post('{{ option.url }}')">
            {{ option.label }}
        </button>
        <span class="poll-count">{{ option.count }}</span>
        <div class="poll-bar-wrap">
            <div class="poll-bar" id="poll-bar-{{ option.key }}" style="width: {{ option.pct }}%; background: {{ option.color }};"></div>
        </div>
    </div>
    {% endfor %}
</div>
