<div class="session-counter-demo demo-box" id="session-counter-demo">
    <div class="demo-box-label">Private counter</div>
    <div class="counter-value" data-text="{{ count.ref }}">{{ count.int }}</div>
    <button class="counter-btn" data-on:click="@post('{{ increment.url }}')">+1</button>
    <p class="counter-note">Only this tab sees this count.</p>
</div>
