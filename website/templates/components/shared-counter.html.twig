<div class="shared-counter demo-box" id="shared-counter">
    <div class="demo-box-label"><span class="live-dot" aria-hidden="true"></span> Shared counter</div>
    <div class="counter-value" data-text="{{ counter.ref }}">
        {{ counter.int }}
    </div>
    <button class="counter-btn" data-on:click="@post('{{ increment.url }}')">+1</button>
    <p class="counter-note">Everyone on this page clicks the same counter.</p>
    <div class="counter-last-click">
        <span data-show="{{ lastClick.ref }}" style="display: {{ lastClick.string ? 'inline' : 'none' }}">Last click by
            <span class="visitor-chip"
                  data-text="{{ lastClick.ref }}"
                  data-attr:style="'--chip-hue:' + {{ lastClickHue.ref }}"
                  style="--chip-hue: {{ lastClickHue.int }}">{{ lastClick.string }}</span>
        </span>
    </div>
</div>
