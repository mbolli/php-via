{#
  Feature comparison, shared by the homepage and /docs/comparisons so the two cannot drift.
  Cells: [content, tone, tooltip]. Content ✓, ~ or ✗ renders as a pixel mark; any other content is
  text, coloured by tone (yes, partial, no or empty). An empty tooltip adds none.
#}
{% set marks = {'✓': 'yes', '~': 'partial', '✗': 'no'} %}
{% set markLabels = {yes: 'Yes', partial: 'Partly', no: 'No'} %}
{% set columns = ['php-via', 'Livewire', 'htmx + Alpine', 'Inertia.js', 'LiveView'] %}
{% set rows = [
    {label: 'Native real-time push', cells: [
        ['✓', 'yes', 'One SSE stream per tab carries every update, and any action, timer or broadcast can push to it.'],
        ['~', 'partial', 'Server push needs Laravel Echo plus a broadcaster such as Reverb, Pusher, Ably or Mercure. Livewire alone offers polling and in-request streaming with wire:stream.'],
        ['~', 'partial', 'The SSE extension streams HTML into the page, but the server side is yours to build.'],
        ['✗', 'no', 'No push channel of its own: use polling, or a separate broadcaster with Laravel Echo.'],
        ['✓', 'yes', 'A persistent WebSocket carries diffs from the server.'],
    ]},
    {label: 'Multiplayer / shared state', cells: [
        ['✓', 'yes', 'Scoped signals: one line shares state with everyone on a route, in a session, in a room or on the whole site.'],
        ['~', 'partial', 'No shared server-side state. Multiplayer UIs broadcast Laravel events through Echo and re-render from the database.'],
        ['✗', 'no', ''],
        ['✗', 'no', ''],
        ['✓', 'yes', 'Phoenix PubSub broadcasts between LiveView processes.'],
    ]},
    {label: 'Scoped state system', cells: [
        ['✓', 'yes', 'TAB, ROUTE, SESSION, GLOBAL, or your own scopes like room:42, with wildcard broadcasts.'],
        ['✗', 'no', ''],
        ['✗', 'no', ''],
        ['✗', 'no', ''],
        ['~', 'partial', 'PubSub topics achieve similar results without a declarative scope system.'],
    ]},
    {label: 'Presence (who is online)', cells: [
        ['✓', 'yes', 'getClients() and countClients() see the tabs on every worker, onClientConnect() and onClientDisconnect() run as tabs come and go, and a closed tab disconnects at once.'],
        ['~', 'partial', 'Laravel presence channels, through Echo and a broadcaster.'],
        ['✗', 'no', ''],
        ['✗', 'no', ''],
        ['✓', 'yes', 'Phoenix.Presence tracks users across nodes.'],
    ]},
    {label: 'No JS to author', cells: [
        ['✓', 'yes', 'No JS files, components or client state. Datastar attributes take one-line expressions such as @post(url).'],
        ['✓', 'yes', 'Typical components use only wire: directives and Blade. Alpine ships bundled for optional client-side behaviour.'],
        ['~', 'partial', 'htmx requests are plain HTML attributes, but Alpine state and behaviour are inline JavaScript expressions.'],
        ['✗', 'no', 'Pages are React, Vue or Svelte components.'],
        ['~', 'partial', 'JS hooks are needed for some client-side interactions.'],
    ]},
    {label: 'No build step', cells: [
        ['✓', 'yes', 'php-via serves its own datastar.js. No bundler, no npm.'],
        ['✓', 'yes', 'Livewire injects its script and Alpine automatically. The documented Echo setup for push uses npm and Vite.'],
        ['✓', 'yes', ''],
        ['✗', 'no', 'npm and Vite build the client.'],
        ['~', 'partial', 'No Node.js: Mix runs standalone esbuild and Tailwind binaries, but the app still bundles its assets.'],
    ]},
    {label: 'File uploads', cells: [
        ['✓', 'yes', "Multipart form submission with Datastar's contentType: 'form' modifier. Files arrive in $c->file()."],
        ['✓', 'yes', 'Temporary uploads with previews, progress events, validation and direct-to-S3 uploads.'],
        ['✓', 'yes', ''],
        ['✓', 'yes', ''],
        ['✓', 'yes', 'Built-in progress, drag and drop, previews and direct-to-cloud uploads.'],
    ]},
    {label: 'Form validation', cells: [
        ['~', 'partial', "No validation API: validate in the action with plain PHP or any validator library, and send per-field errors back as signals or re-rendered HTML. With contentType: 'form', the browser's HTML5 checks run first."],
        ['✓', 'yes', "Laravel's validator through #[Validate] attributes or form objects."],
        ['~', 'partial', 'HTML5 checks in the browser. Server-side errors come back as HTML from your backend.'],
        ['✓', 'yes', 'Server validation errors arrive as props from the backend adapter.'],
        ['✓', 'yes', 'Ecto changesets validate on change and on submit.'],
    ]},
    {label: 'Auth / middleware', cells: [
        ['✓', 'yes', 'PSR-15 middleware per route or group. Actions are bound to the session and check the Origin header.'],
        ['✓', 'yes', ''],
        ['✓', 'yes', 'Provided by the backend you pair it with.'],
        ['✓', 'yes', ''],
        ['✓', 'yes', ''],
    ]},
    {label: 'Built-in debugging / observability', cells: [
        ['✓', 'yes', 'The Dev Bar ships with the framework and turns on with dev mode: a request-trace waterfall, the raw SSE patches, and live signal, scope and log panels.'],
        ['~', 'partial', 'No built-in inspector. Laravel Debugbar detects Livewire components, plus Telescope and community browser extensions.'],
        ['~', 'partial', 'Console event logging plus third-party htmx and Alpine DevTools extensions, with no in-page inspector.'],
        ['✓', 'yes', 'The first-party Inertia DevTools browser panel records every visit with its props and headers (Laravel adapter).'],
        ['✓', 'yes', 'Phoenix LiveDashboard (real-time metrics, requests, processes) plus HEEx debug annotations.'],
    ]},
    {label: 'Multi-core on one server', cells: [
        ['✓', 'yes', 'withWorkerNum(), with SwooleBroker by default: scoped signals, GlobalState, session data and the client list live in shared memory, and an action reaches its tab on any worker.'],
        ['✓', 'yes', ''],
        ['✓', 'yes', ''],
        ['✓', 'yes', ''],
        ['✓', 'yes', ''],
    ]},
    {label: 'Multi-server', cells: [
        ['~', 'partial', 'RedisBroker or NatsBroker carries broadcasts between servers. Use sticky sessions and keep shared state in a database.'],
        ['✓', 'yes', ''],
        ['✓', 'yes', ''],
        ['✓', 'yes', ''],
        ['✓', 'yes', 'Distributed PubSub and Presence across nodes.'],
    ]},
    {label: 'Runs without a long-running process', cells: [
        ['✗', 'no', 'Needs a long-running OpenSwoole 26 process behind a reverse proxy. No PHP-FPM or shared hosting.'],
        ['✓', 'yes', 'Plain PHP-FPM. Real-time push adds a Reverb process.'],
        ['✓', 'yes', 'Any backend. Under PHP-FPM every open SSE stream ties up a worker.'],
        ['✓', 'yes', 'Plain PHP-FPM. Server-side rendering adds a Node.js process.'],
        ['✗', 'no', 'Runs as a long-lived BEAM release.'],
    ]},
    {label: 'No server memory per open tab', cells: [
        ['✗', 'no', 'Every open tab holds its context and its SSE stream in server memory.'],
        ['✓', 'yes', 'Component state travels with each request in a checksummed snapshot.'],
        ['✓', 'yes', ''],
        ['✓', 'yes', ''],
        ['✗', 'no', 'Each LiveView is a BEAM process that holds its state.'],
    ]},
    {label: 'Ecosystem & community', cells: [
        ['Early', '', ''],
        ['Large', '', ''],
        ['Large', '', ''],
        ['Large', '', ''],
        ['Large', '', ''],
    ]},
    {label: 'Framework required', cells: [
        ['No', 'yes', 'php-via is its own server. Next to a Laravel or Symfony app it runs as a separate process.'],
        ['Laravel', 'no', ''],
        ['No', 'yes', ''],
        ['React, Vue or Svelte', 'partial', 'Plus a server adapter: Laravel is first-party, and community adapters cover Rails, Phoenix, Django, Symfony and more.'],
        ['Phoenix', 'no', ''],
    ]},
    {label: 'Language', cells: [
        ['PHP', '', ''],
        ['PHP', '', ''],
        ['PHP + JS', '', ''],
        ['PHP + JS', '', ''],
        ['Elixir', '', ''],
    ]},
    {label: 'Runtime', cells: [
        ['OpenSwoole 26', '', ''],
        ['PHP-FPM or Octane', '', ''],
        ['Any backend', '', ''],
        ['PHP-FPM, Node for SSR', '', ''],
        ['BEAM VM', '', ''],
    ]},
] %}
<div class="comparison-table-wrap">
    <table class="comparison-table">
        <thead>
            <tr>
                <th style="text-align:left;">Feature</th>
                {% for column in columns %}<th>{{ column }}</th>{% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for row in rows %}
                {% set r = loop.index %}
                <tr>
                    <td>{{ row.label }}</td>
                    {% for cell in row.cells %}
                        {% set key = r ~ '-' ~ loop.index %}
                        {% if marks[cell[0]] is defined %}
                            {% set tone = marks[cell[0]] %}
                            {% set content %}<span class="cmp-mark cmp-mark--{{ tone }}" role="img" aria-label="{{ markLabels[tone] }}"><span class="visually-hidden">{{ cell[0] }}</span></span>{% endset %}
                        {% elseif cell[1] %}
                            {% set content %}<span class="cmp-text cmp-text--{{ cell[1] }}">{{ cell[0] }}</span>{% endset %}
                        {% else %}
                            {% set content %}{{ cell[0] }}{% endset %}
                        {% endif %}
                        <td>
                            {%- if cell[2] -%}
                                <span class="has-tooltip" tabindex="0" aria-describedby="cmp-tip-{{ key }}" style="anchor-name:--cmp-{{ key }}">{{ content }}<span role="tooltip" id="cmp-tip-{{ key }}" class="tooltip" style="position-anchor:--cmp-{{ key }}">{{ cell[2] }}</span></span>
                            {%- else -%}
                                {{ content }}
                            {%- endif -%}
                        </td>
                    {% endfor %}
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
