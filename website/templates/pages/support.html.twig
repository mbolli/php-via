{% extends 'shells/base.html.twig' %}
{% block title %}Professional Support · php-via{% endblock %}
{% block description %}php-via project builds, OpenSwoole consulting, real-time architecture, training and embedded engineering from zwei und eins gmbh, the company that builds php-via.{% endblock %}
{% block body_class %}page-px{% endblock %}
{% block content %}

<section class="px-hero px-hero--page">
    <div class="px-wrap px-hero-grid">
        <div class="px-hero-copy">
            <p class="px-kicker">Professional support</p>
            <h1 class="px-page-title">Work with the team that builds php-via</h1>
            <p class="px-hero-lead">
                zwei und eins gmbh created php-via and maintains it. We build applications on it, run
                OpenSwoole in production and design real-time features. You can hire us for your project,
                for a review, or for a few months of engineering.
            </p>
            <div class="px-actions">
                <a href="mailto:info@zweiundeins.gmbh" class="px-btn px-btn--primary">Email us <span aria-hidden="true">→</span></a>
                <a href="https://zweiundeins.gmbh" class="px-btn" target="_blank" rel="noopener">zweiundeins.gmbh <span class="px-ext" aria-hidden="true"></span></a>
            </div>
        </div>

        <aside class="px-panel" aria-labelledby="support-contact-title">
            <div class="px-panel-bar">
                <h2 class="px-panel-title" id="support-contact-title">Contact details</h2>
            </div>
            <dl class="px-facts">
                <div>
                    <dt>Email</dt>
                    <dd><a href="mailto:info@zweiundeins.gmbh">info@zweiundeins.gmbh</a></dd>
                </div>
                <div>
                    <dt>First reply</dt>
                    <dd>Within one business day</dd>
                </div>
                <div>
                    <dt>Proposal</dt>
                    <dd>In writing, two business days after the scoping call</dd>
                </div>
                <div>
                    <dt>Company</dt>
                    <dd>zwei und eins gmbh, a Swiss software consultancy</dd>
                </div>
            </dl>
        </aside>
    </div>
</section>

<section class="px-section" id="services">
    <div class="px-wrap">
        <header class="px-section-head">
            <h2>Services for php-via projects</h2>
            <p>
                We take on a single feature, an architecture review or a long engagement. Each one starts
                with a written scope and the deliverables we agree on.
            </p>
        </header>
        <div class="px-specs">
            <div class="px-spec">
                <h3>php-via project builds</h3>
                <p>We design and build your application on php-via, from the first page to production: OpenSwoole, Datastar, and a scope design that decides who shares which state.</p>
            </div>
            <div class="px-spec">
                <h3>OpenSwoole and async PHP</h3>
                <p>Coroutine scheduling, the event loop and long-running workers. We find memory leaks, connection storms and timer drift in production systems.</p>
            </div>
            <div class="px-spec">
                <h3>Real-time and SSE architecture</h3>
                <p>Server-sent event systems, broadcast strategies, Redis and NATS brokers, and scaling across servers. We benchmark these patterns for php-via itself, as the <a href="/docs/performance">performance page</a> shows.</p>
            </div>
            <div class="px-spec">
                <h3>PHP architecture consulting</h3>
                <p>For new projects and legacy code, we help you choose patterns that fit your scale, your team and how often you ship. Code reviews, architecture decision records and hands-on refactoring are part of it.</p>
            </div>
            <div class="px-spec">
                <h3>Embedded engineering</h3>
                <p>A senior PHP engineer joins your team for a defined scope, with clear deliverables and regular check-ins.</p>
            </div>
            <div class="px-spec">
                <h3>Training and workshops</h3>
                <p>Sessions built around your team and your codebase, from async PHP basics to php-via scope design and running it in production. We teach remotely or on site.</p>
            </div>
        </div>
    </div>
</section>

<section class="px-section" id="about">
    <div class="px-wrap">
        <header class="px-section-head">
            <h2>About zwei und eins gmbh</h2>
        </header>
        <div class="px-founder">
            <div class="px-founder-avatar" aria-hidden="true">MB</div>
            <div class="px-founder-bio">
                <p>
                    <strong>Michael Bolli</strong> created php-via and owns
                    <a href="https://zweiundeins.gmbh" target="_blank" rel="noopener">zwei und eins gmbh</a>,
                    a Swiss software consultancy for real-time PHP, backend architecture and
                    high-performance web systems.
                </p>
                <p>
                    php-via grew out of production work. PHP projects kept adding WebSocket servers, polling
                    loops and JavaScript frameworks to solve problems that belong on the server. php-via gives
                    PHP developers the server-driven model that Phoenix LiveView gives Elixir teams, without
                    a move to Elixir.
                </p>
                <p>
                    When you hire us, you work directly with the engineer who designed the framework.
                </p>
                <div class="px-founder-links">
                    <a href="https://zweiundeins.gmbh" target="_blank" rel="noopener" class="px-btn px-btn--sm">Company website <span class="px-ext" aria-hidden="true"></span></a>
                    <a href="https://linkedin.com/in/mbolli" target="_blank" rel="noopener" class="px-btn px-btn--sm">LinkedIn <span class="px-ext" aria-hidden="true"></span></a>
                    <a href="https://github.com/mbolli" target="_blank" rel="noopener" class="px-btn px-btn--sm">GitHub <span class="px-ext" aria-hidden="true"></span></a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="px-section" id="process">
    <div class="px-wrap">
        <header class="px-section-head">
            <h2>How an engagement starts</h2>
            <p>Three steps lead from the first email to work on your code.</p>
        </header>
        <ol class="px-flow px-flow--3">
            <li class="px-flow-step">
                <span class="px-flow-code">Step 1</span>
                <h3>Email</h3>
                <p>Describe your project and what you need in a short email. An NDA can wait until we talk about details.</p>
            </li>
            <li class="px-flow-step">
                <span class="px-flow-code">Step 2</span>
                <h3>Scoping call</h3>
                <p>In a 30-minute call we agree on scope, deliverables and what success looks like. A written proposal follows by email within two business days.</p>
            </li>
            <li class="px-flow-step">
                <span class="px-flow-code">Step 3</span>
                <h3>Kick-off</h3>
                <p>We start, either embedded in your team or as an external partner, with regular check-ins and deliverables you can review.</p>
            </li>
        </ol>
    </div>
</section>

<section class="px-section px-section--last" id="contact">
    <div class="px-wrap px-cta">
        <header class="px-section-head">
            <h2>Contact zwei und eins gmbh</h2>
            <p>Write to us about your project. We reply within one business day.</p>
        </header>
        <div class="px-actions">
            <a href="mailto:info@zweiundeins.gmbh" class="px-btn px-btn--primary">info@zweiundeins.gmbh</a>
            <a href="https://zweiundeins.gmbh" class="px-btn" target="_blank" rel="noopener">Visit zweiundeins.gmbh <span class="px-ext" aria-hidden="true"></span></a>
        </div>
    </div>
</section>

{% endblock %}
