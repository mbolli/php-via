<section class="px-section" id="counter">
    <div class="px-wrap">
        <header class="px-section-head">
            <h2>A complete counter app</h2>
            <p>
                The listing is a full <code>app.php</code>. The <strong>TAB</strong> version is the default:
                every browser tab keeps its own count. The <strong>GLOBAL</strong> version adds
                <code>$c-&gt;scope(Scope::GLOBAL)</code>, and all visitors share the count. <strong>Composition</strong> shows the same counter as a
                class with <code>#[Signal]</code> and <code>#[Action]</code> attributes, as described in the
                <a href="/docs/composition">composition docs</a>.
            </p>
        </header>
        <div class="code-examples-split">
        <div class="code-panel">
            <input type="radio" name="home-code-tab" id="home-tab-private" class="tab-radio" checked>
            <input type="radio" name="home-code-tab" id="home-tab-global" class="tab-radio">
            <input type="radio" name="home-code-api" id="home-api-closure" class="tab-radio" checked>
            <input type="radio" name="home-code-api" id="home-api-composition" class="tab-radio">
            <div class="code-panel-header code-panel-tabs">
                <div class="code-tab-group">
                    <label for="home-tab-private" class="code-tab-label">
                        <span class="scope-badge scope-tab">TAB</span> Private counter
                    </label>
                    <label for="home-tab-global" class="code-tab-label">
                        <span class="scope-badge scope-global">GLOBAL</span> Shared counter
                    </label>
                </div>
                <div class="code-api-toggle" role="group" aria-label="API style">
                    <label for="home-api-closure" class="code-api-label">Closure</label>
                    <label for="home-api-composition" class="code-api-label">Composition</label>
                </div>
            </div>
            <div class="tab-panes-wrapper">
            <div class="tab-pane scope-private api-closure">
                {% code 'php' gutter %}{% verbatim %}
<?php
require __DIR__ . '/vendor/autoload.php';

use Mbolli\PhpVia\Config;
use Mbolli\PhpVia\Context;
use Mbolli\PhpVia\Via;

$app = new Via(new Config());

$app->page('/', function (Context $c): void {
    // TAB scope (default): each visitor has their own counter
    $count = $c->signal(0);

    $increment = $c->action(
        fn() => $count->setValue($count->int() + 1)
    );

    $c->view(fn() => <<<HTML
        <p>Count: <strong data-text="\${$count->id()}">
            {$count->int()}
        </strong></p>
        <button data-on:click="@post('{$increment->url()}')">
            +1
        </button>
    HTML);
});

$app->start();
                {% endverbatim %}{% endcode %}
            </div>
            <div class="tab-pane scope-global api-closure">
                {% code 'php' gutter %}{% verbatim %}
<?php
require __DIR__ . '/vendor/autoload.php';

use Mbolli\PhpVia\Config;
use Mbolli\PhpVia\Context;
{+use Mbolli\PhpVia\Scope;+}
use Mbolli\PhpVia\Via;

$app = new Via(new Config());

$app->page('/', function (Context $c): void {
{-    // TAB scope (default): each visitor has their own counter-}
{+    // GLOBAL scope: one shared counter for every visitor
    $c->scope(Scope::GLOBAL);+}
    $count = $c->signal(0);

    $increment = $c->action(
{-        fn() => $count->setValue($count->int() + 1)-}
{+        fn() => $count->increment()+}
    );

    $c->view(fn() => <<<HTML
        <p>Count: <strong data-text="\${$count->id()}">
            {$count->int()}
        </strong></p>
        <button data-on:click="@post('{$increment->url()}')">
            +1
        </button>
    HTML);
});

$app->start();
                {% endverbatim %}{% endcode %}
            </div>
            <div class="tab-pane scope-private api-composition">
                {% code 'php' gutter %}{% verbatim %}
<?php
require __DIR__ . '/vendor/autoload.php';

use Mbolli\PhpVia\Attributes\Action;
use Mbolli\PhpVia\Attributes\Signal;
use Mbolli\PhpVia\Config;
use Mbolli\PhpVia\Context;
use Mbolli\PhpVia\Via;

final class Counter {
    // TAB scope (default): each visitor has their own counter
    #[Signal]
    public int $count = 0;

    #[Action]
    public function increment(): void {
        $this->count++;
    }

    public function view(Context $c): void {
        $count = $c->getSignal('count');
        $increment = $c->getAction('increment');

        $c->view(fn() => <<<HTML
            <p>Count: <strong data-text="\${$count->id()}">
                {$count->int()}
            </strong></p>
            <button data-on:click="@post('{$increment->url()}')">
                +1
            </button>
        HTML);
    }
}

$app = new Via(new Config());
$app->mount(Counter::class, '/');
$app->start();
                {% endverbatim %}{% endcode %}
            </div>
            <div class="tab-pane scope-global api-composition">
                {% code 'php' gutter %}{% verbatim %}
<?php
require __DIR__ . '/vendor/autoload.php';

use Mbolli\PhpVia\Attributes\Action;
use Mbolli\PhpVia\Attributes\Signal;
use Mbolli\PhpVia\Config;
use Mbolli\PhpVia\Context;
{+use Mbolli\PhpVia\Scope;+}
use Mbolli\PhpVia\Via;

final class Counter {
{-    // TAB scope (default): each visitor has their own counter
    #[Signal]-}
{+    // GLOBAL scope: one shared counter, atomic so no click is lost
    #[Signal(Scope::GLOBAL, atomic: true)]+}
    public int $count = 0;

    #[Action]
    public function increment(): void {
        $this->count++;
    }

    public function view(Context $c): void {
        $count = $c->getSignal('count');
        $increment = $c->getAction('increment');

        $c->view(fn() => <<<HTML
            <p>Count: <strong data-text="\${$count->id()}">
                {$count->int()}
            </strong></p>
            <button data-on:click="@post('{$increment->url()}')">
                +1
            </button>
        HTML);
    }
}

$app = new Via(new Config());
$app->mount(Counter::class, '/');
$app->start();
                {% endverbatim %}{% endcode %}
            </div>
            </div>{# /tab-panes-wrapper #}
        </div>
            <div class="demos-stack">
                {{ sessionCounter | raw }}
                {{ sharedCounter | raw }}
                <p class="px-demos-note">Both counters run on this server. Open the page in a second window to compare them.</p>
            </div>
        </div>
    </div>
</section>
<script>
(function () {
    function activePane(panel) {
        var scope = panel.querySelector('input[name="home-code-tab"]:checked');
        var api = panel.querySelector('input[name="home-code-api"]:checked');
        if (!scope || !api) return null;
        var s = scope.id === 'home-tab-global' ? 'scope-global' : 'scope-private';
        var a = api.id === 'home-api-composition' ? 'api-composition' : 'api-closure';
        return panel.querySelector('.tab-pane.' + s + '.' + a);
    }
    function syncHeight(panel) {
        var pane = activePane(panel);
        if (pane) panel.querySelector('.tab-panes-wrapper').style.height = pane.scrollHeight + 'px';
    }
    document.querySelectorAll('.code-panel').forEach(syncHeight);
    document.querySelectorAll('.code-panel label[for]').forEach(function (label) {
        label.addEventListener('click', function () {
            var radio = document.getElementById(label.htmlFor);
            if (!radio || radio.checked) return;
            var panel = label.closest('.code-panel');
            radio.checked = true;
            syncHeight(panel);
        });
    });
    window.addEventListener('resize', function () {
        document.querySelectorAll('.code-panel').forEach(syncHeight);
    });
}());
</script>

<section class="px-section" id="how-it-works">
    <div class="px-wrap">
        <header class="px-section-head">
            <h2>How a php-via page works</h2>
            <p>
                php-via runs your app as one long-lived OpenSwoole process. Page state stays in memory
                between requests, so the server can push a change the moment it happens. A click posts to
                an action, the action changes signals, and php-via sends the new HTML and signal values to
                every tab that should see them.
            </p>
        </header>

        <ol class="px-flow">
            <li class="px-flow-step">
                <code class="px-flow-code">$c-&gt;signal(0)</code>
                <h3>Signal</h3>
                <p>State held on the server. The browser keeps a copy, and Datastar updates the page when it changes.</p>
            </li>
            <li class="px-flow-step">
                <code class="px-flow-code">$c-&gt;action(fn)</code>
                <h3>Action</h3>
                <p>A PHP function the browser calls with a POST, for a click or a keystroke. It changes signals.</p>
            </li>
            <li class="px-flow-step">
                <code class="px-flow-code">$c-&gt;view(…)</code>
                <h3>View</h3>
                <p>HTML from Twig or a PHP heredoc. After an action, php-via renders it again and sends the new HTML.</p>
            </li>
            <li class="px-flow-step">
                <code class="px-flow-code">GET /_sse</code>
                <h3>Browser</h3>
                <p>Datastar reads the patch from the tab's SSE stream and morphs it into the page without a reload.</p>
            </li>
        </ol>

        <div class="px-scopes">
            <div class="px-scopes-text">
                <h3>Scopes</h3>
                <p>
                    A scope decides who shares a signal and who receives a broadcast. The default is
                    <code>Scope::TAB</code>, so state is private until you choose otherwise.
                    <a href="/docs/scopes">Read the scopes guide</a>.
                </p>
            </div>
            <table class="px-scope-table">
                <thead>
                    <tr><th scope="col">Scope</th><th scope="col">Shared by</th></tr>
                </thead>
                <tbody>
                    <tr><td><code>Scope::TAB</code></td><td>one browser tab (the default)</td></tr>
                    <tr><td><code>Scope::ROUTE</code></td><td>everyone on the same route</td></tr>
                    <tr><td><code>Scope::SESSION</code></td><td>all tabs of one browser session</td></tr>
                    <tr><td><code>Scope::GLOBAL</code></td><td>every visitor on every route</td></tr>
                    <tr><td><code>'room:42'</code></td><td>a scope you name; broadcast to <code>room:*</code> to reach them all</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

<section class="px-section" id="features">
    <div class="px-wrap">
        <header class="px-section-head">
            <h2>Features</h2>
        </header>
        <div class="px-specs">
            <div class="px-spec">
                <h3>PHP and HTML only</h3>
                <p>Datastar reads attributes such as <code>data-on:click="@post(...)"</code> and talks to the server for you. You maintain no JS files and no client-side state.</p>
            </div>
            <div class="px-spec">
                <h3>Runs without a build step</h3>
                <p><code>php app.php</code> starts the server. php-via serves its own <code>datastar.js</code>, so you need neither a bundler nor npm before the first page loads.</p>
            </div>
            <div class="px-spec">
                <h3>Closures or classes</h3>
                <p>Write a page as a closure for a quick script, or as a class with <code>#[Signal]</code> and <code>#[Action]</code> attributes for a larger app. Both run on the same engine.</p>
            </div>
            <div class="px-spec">
                <h3>Scoped state</h3>
                <p>TAB, ROUTE, SESSION, GLOBAL, or your own scopes like <code>room:42</code>. One line decides whether state is private to a tab or shared with everyone.</p>
            </div>
            <div class="px-spec">
                <h3>Atomic shared signals</h3>
                <p>Give a signal ROUTE scope and every visitor on the route sees its changes, on every worker. One machine needs no pub/sub service, and <code>increment()</code> keeps simultaneous clicks from overwriting each other.</p>
            </div>
            <div class="px-spec">
                <h3>One SSE stream per tab</h3>
                <p>A single persistent connection carries every update for the tab. With <code>withBrotli()</code>, php-via compresses the stream itself and the reverse proxy passes it through.</p>
            </div>
            <div class="px-spec">
                <h3>Components</h3>
                <p>Build a page from isolated sub-contexts, written as closures or classes. Each component has its own signals, actions and view.</p>
            </div>
            <div class="px-spec">
                <h3>Multi-core workers</h3>
                <p><code>withWorkerNum()</code> spreads tabs over every core. Scoped signals and session data live in shared memory, and any worker can answer any tab.</p>
            </div>
            <div class="px-spec">
                <h3>Dev Bar</h3>
                <p>A debug overlay with a request trace, the raw SSE patches, and live signal, scope and log panels. It runs on this page: open the <strong>via</strong> pill in the bottom-right corner.</p>
            </div>
        </div>
    </div>
</section>

<section class="px-section" id="poll">
    <div class="px-wrap px-poll">
        <header class="px-section-head">
            <h2>A live poll with ROUTE scope</h2>
            <p>
                The tally lives on the server, and the poll component has <code>Scope::ROUTE</code>, so every
                browser on this page renders the same bars. Vote here, or open a second window and vote there.
            </p>
        </header>
        <div class="px-poll-demo">
            {{ poll | raw }}
        </div>
    </div>
</section>

<section class="px-section" id="comparison">
    <div class="px-wrap">
        <header class="px-section-head">
            <h2>Comparison with Livewire, htmx, Inertia.js and LiveView</h2>
            <p>
                Livewire and Inertia.js send a new HTTP request when something changes, and htmx does the
                same unless you add its SSE extension. php-via keeps one connection open per tab and pushes
                changes down it, like Phoenix LiveView, which inspired its architecture. Hover or focus a
                mark for the details, or read the <a href="/docs/comparisons">comparisons page</a>.
            </p>
        </header>
        {% include 'components/comparison-table.html.twig' %}
    </div>
</section>

<section class="px-section px-section--install" id="install">
    <div class="px-wrap px-install-grid">
        <header class="px-section-head">
            <h2>Install php-via</h2>
            <p>
                php-via needs PHP 8.4 or newer and the OpenSwoole 26 extension. Composer installs the rest.
                Put the counter from above in <code>app.php</code> and start it.
            </p>
            <div class="px-actions">
                <a href="/docs/getting-started" class="px-btn px-btn--primary">Getting started guide <span aria-hidden="true">→</span></a>
                <a href="/examples" class="px-btn">Live examples</a>
            </div>
        </header>
        <div class="px-terminal" role="group" aria-label="Install commands">
            <div class="px-terminal-bar">~/my-app</div>
            <pre class="px-terminal-body"><span class="px-terminal-prompt" aria-hidden="true">$ </span>composer require mbolli/php-via
<span class="px-terminal-prompt" aria-hidden="true">$ </span>php app.php
<span class="px-terminal-out">[INFO] Via server started on http://0.0.0.0:3000</span></pre>
        </div>
    </div>
</section>

<script>
(function () {
    var btn = document.querySelector('.px-install-copy');
    if (!btn || !navigator.clipboard) { if (btn) btn.hidden = true; return; }
    btn.addEventListener('click', function () {
        var text = document.getElementById(btn.dataset.copy).textContent;
        navigator.clipboard.writeText(text).then(function () {
            btn.textContent = 'Copied';
            setTimeout(function () { btn.textContent = 'Copy'; }, 1500);
        });
    });
}());
</script>

{% endblock %}
