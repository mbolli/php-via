{% extends 'shells/base.html.twig' %}
{% block title %}php-via: server-side reactive UIs in PHP{% endblock %}
{% block description %}php-via is a PHP framework for server-side reactive web UIs. It runs on OpenSwoole, and Datastar applies its updates over one SSE stream per browser tab. Scopes decide who shares state.{% endblock %}
{% block body_class %}page-home{% endblock %}
{% block head %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "php-via",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Linux, macOS",
    "programmingLanguage": "PHP",
    "description": "PHP framework for server-side reactive web UIs, built on OpenSwoole, Datastar and Twig.",
    "url": "https://via.zweiundeins.gmbh/",
    "downloadUrl": "https://packagist.org/packages/mbolli/php-via",
    "installUrl": "https://packagist.org/packages/mbolli/php-via",
    "softwareVersion": "latest",
    "softwareRequirements": "PHP 8.4 or higher, OpenSwoole PHP extension",
    "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
    },
    "creator": {"@type": "Person", "@id": "https://zweiundeins.gmbh/#mbolli"},
    "maintainer": {"@type": "Organization", "@id": "https://zweiundeins.gmbh/#organization"},
    "license": "https://opensource.org/licenses/MIT",
    "codeRepository": "https://github.com/mbolli/php-via",
    "keywords": ["PHP", "real-time", "reactive", "OpenSwoole", "Datastar", "SSE", "server-sent events", "no JavaScript", "multiplayer", "web framework"]
}
</script>
{% endblock %}
{% block content %}

<section class="px-hero">
    <div class="px-wrap px-hero-grid">
        <div class="px-hero-copy">
            <h1 class="px-hero-title">
                <span class="px-wordmark">php-via</span>
                <span class="px-hero-sub">Server-side reactive UIs in PHP</span>
            </h1>
            <p class="px-hero-lead">
                php-via keeps the state of each page on the server. You write signals, actions and
                views in PHP. Datastar applies the server's patches in the browser over one SSE
                stream per tab, and scopes decide who shares which state.
            </p>

            <div class="px-actions">
                <a href="/docs/getting-started" class="px-btn px-btn--primary">Get started <span aria-hidden="true">→</span></a>
                <a href="/examples" class="px-btn">Examples</a>
                <a href="https://github.com/mbolli/php-via" class="px-btn px-btn--ghost" target="_blank" rel="noopener">
                    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
                    GitHub
