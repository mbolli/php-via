{% extends 'shells/base.html.twig' %}

{% macro navlink(href, label, currentRoute, basePath) %}
    <li>
        <a href="{{ basePath }}{{ href }}"
            {% if ('/' ~ href) == currentRoute %}aria-current="page" class="active"{% endif %}>{{ label }}</a>
    </li>
{% endmacro %}

{% macro groups(currentRoute, basePath) %}
    {% import _self as m %}
    {% for group in constant('PhpVia\\Website\\ExampleCatalog::GROUPS') %}
        <section class="sidebar-section">
            <h3 class="sidebar-heading"><span>{{ group.name }}</span>{% if group.multiplayer %} <span class="badge badge-multiplayer">multiplayer</span>{% endif %}</h3>
            <ul role="list">
                {% for item in group.items %}
                    {{ m.navlink(item.route, item.label, currentRoute, basePath) }}
                {% endfor %}
            </ul>
        </section>
    {% endfor %}
{% endmacro %}

{% block body_class %}docs-body{% endblock %}

{% block layout %}
<div class="docs-layout">
    <aside class="docs-sidebar" role="complementary" aria-label="Examples navigation">
        <nav class="sidebar-nav">
            {% import _self as m %}
            <section class="sidebar-section">
                <ul role="list">
                    {{ m.navlink('examples', 'Overview', currentRoute, basePath) }}
                </ul>
            </section>
            {{ m.groups(currentRoute, basePath) }}
        </nav>
    </aside>

    <main class="docs-content" id="content">
        <details class="mobile-subnav" data-ignore-morph>
            <summary>Examples menu</summary>
            <nav class="sidebar-nav">
                <ul role="list">
                    {{ m.navlink('examples', 'Overview', currentRoute, basePath) }}
                </ul>
                {{ m.groups(currentRoute, basePath) }}
            </nav>
        </details>
        {% block content %}{% endblock %}
    </main>

</div>
{% endblock %}
