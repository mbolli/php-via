{% extends 'shells/docs.html.twig' %}
{% block title %}Views · php-via Docs{% endblock %}
{% block content %}
<article>
    <h1>Views</h1>
    <p>
        A view is the HTML a context renders for its client. php-via re-renders and patches it automatically
        whenever signals change, no manual DOM manipulation required.
    </p>

    <h2 id="defining">Defining a view</h2>
    <p>Call <code>$c-&gt;view()</code> once per context. It accepts either a Twig template name or a callable:</p>
    {% code 'php' %}{% verbatim %}
// Twig template: signals and actions are auto-injected; only pass non-signal data
$c->view('counter.html.twig');

// With extra data (e.g. PHP arrays, scalars that aren't signals):
$c->view('todo.html.twig', ['todos' => $todos]);

// Callable (inline)
$c->view(function () use ($count, $increment): string {
    return "<p>Count: {$count->int()}</p>"
         . "<button data-on:click=\"@post('{$increment->url()}')\">&gt;+1</button>";
});
{% endverbatim %}{% endcode %}

    <h2 id="partial-updates">Partial updates with <code>block:</code></h2>
    <p>
        By default, every SSE update re-renders the <em>entire</em> Twig template and sends it to
        the browser. When your template uses Twig blocks, you can tell php-via to send only a named
        block on updates, keeping the initial page load complete while making SSE patches smaller
        and faster:
    </p>
    {% code 'php' %}{% verbatim %}
// On initial load: renders the full template (layout, nav, content)
// On SSE updates:  renders only {% block demo %}
// addTodo (action) is auto-injected; only pass non-signal data explicitly
$c->view('todo.html.twig', fn (): array => [
    'todos' => self::$todos,
], block: 'demo');
{% endverbatim %}{% endcode %}
    {% code 'twig' %}{% verbatim %}
{# todo.html.twig #}
{% extends 'base.html.twig' %}

{% block content %}
    <h1>My App</h1>
    <p>Description and chrome that only renders on initial load.</p>

    {% block demo %}
    <div id="todo-list">
        {# This block is all that gets sent on SSE updates #}
        {# The root element needs a unique id so Datastar can find the morph target #}
        {% for todo in todos %}
            <li>{{ todo.text }}</li>
        {% endfor %}
    </div>
    {% endblock %}
{% endblock %}
{% endverbatim %}{% endcode %}

    <p>The <code>block:</code> parameter belongs to template views. Pass the data as an array, or as a callable that builds it on every render:</p>
    {% code 'php' %}{% verbatim %}
// Data fixed when the view is defined
$c->view('todo.html.twig', ['todos' => $todos], block: 'demo');

// Data read again on every render
$c->view('todo.html.twig', fn (): array => ['todos' => self::$todos], block: 'demo');
{% endverbatim %}{% endcode %}

    <h3>When to use <code>block:</code></h3>
    <ul>
        <li><strong>Use it</strong> when your template has a named block wrapping the dynamic content
            and the surrounding layout is static (header, description, nav).</li>
        <li><strong>Give block content a root element with a unique <code>id</code></strong>:
            Datastar uses the root element's <code>id</code> to find the morph target in the DOM.
            Any unique ID works (e.g. <code>todo-list</code>, <code>game-grid</code>).</li>
        <li><strong>Don't need it</strong> for signal-only updates (<code>syncSignals()</code>): no
            HTML is re-rendered at all.</li>
        <li><strong>Don't need it</strong> for <a href="/docs/components">components</a>: each
            component already patches only its own <code>&lt;div&gt;</code>.</li>
    </ul>

    <details>
        <summary>Advanced: the <code>$isUpdate</code> parameter</summary>
        <p>
            View callables receive <code>(bool $isUpdate, string $basePath)</code> as arguments.
            Most views don't need these: <code>block:</code> handles the common case. When the part that
            changes is rendered on its own, in PHP or in a separate template, <code>$isUpdate</code> lets
            updates send only that part:
        </p>
        {% code 'php' %}{% verbatim %}
// Updates send only <div id="live">; Datastar morphs it by its id
$c->view(function (bool $isUpdate) use ($c, $data): string {
    $live = $c->render('live.html.twig', $data);
    if ($isUpdate) {
        return $live;
    }

    return $c->render('page.html.twig', $data + ['live' => $live]);
});
{% endverbatim %}{% endcode %}
        <p>
            On a page with <a href="/docs/components">components</a>, give each component a name
            (<code>$c->component($fn, 'cart')</code>). A named component gets the same id every time its page
            is built, so a revived tab's component updates find the elements the browser still has, even when
            the page returns <code>''</code> on updates. An unnamed component gets a new id on revival, and only
            a page frame that renders it again can put that id into the page.
        </p>
    </details>

    <h2 id="update-cycle">How updates work</h2>
    <p>When a signal changes inside an action:</p>
    <ol>
        <li><code>$c-&gt;sync()</code> is called (either explicitly or via auto-broadcast on scoped signals)</li>
        <li>php-via re-renders the view callable/template with fresh values</li>
        <li>The new HTML is diffed against the previous render and patched to the browser via SSE</li>
        <li>Datastar morphs only the changed DOM nodes, no full page reload</li>
    </ol>

    <h2 id="sync-vs-sync-signals">sync() vs syncSignals()</h2>
    <p>
        <code>$c-&gt;sync()</code> re-renders the view <em>and</em> pushes signal values.
        If only signal values changed (no structural HTML change), use <code>$c-&gt;syncSignals()</code>. It skips
        view re-rendering and is faster:
    </p>
    {% code 'php' %}{% verbatim %}
// Only a signal label changed: no need to re-render the whole view
$c->action(function (Context $c) use ($status): void {
    $status->setValue('Saved!');
    $c->syncSignals();
}, 'save');
    {% endverbatim %}{% endcode %}

    <h2 id="caching">Sharing one render</h2>
    <p>
        Each tab renders its own update. A view that is the same for every tab in its scope can pass
        <code>shareRender: true</code>: when a broadcast reaches the scope, the first context renders the view
        and every other context of the same route and component in that primary scope receives the same HTML.
        It needs a primary scope set with <code>scope()</code>, and a full-document view never shares its
        render. A broadcast drops the shared render of every context it reaches, so a view that reads state
        outside signals, such as <code>$app->getClients()</code>, is current after each broadcast.
    </p>
    {% code 'php' %}{% verbatim %}
// Every tab on this route shows the same board, so it renders once per broadcast
$c->scope(Scope::ROUTE);
$c->view('board.html.twig', fn (): array => ['cells' => $board->cells()], block: 'board', shareRender: true);
{% endverbatim %}{% endcode %}

    <h2 id="components">Views in components</h2>
    <p>
        Each <a href="/docs/components">component</a> defines its own view. Component views update independently
        from the parent context: only the signals owned by that component need to change for it to re-render.
    </p>
    {% code 'php' %}{% verbatim %}
$counter = $c->component(function (Context $c): void {
    $n   = $c->signal(0, 'n');
    $inc = $c->action(fn() => $n->setValue($n->int() + 1) & $c->sync(), 'inc');
    // n and inc are auto-injected into counter.html.twig
    $c->view('counter.html.twig');
}, 'counter');

$c->view(fn (): string => $c->render('page.html.twig', ['counter' => $counter()]));
{% endverbatim %}{% endcode %}

    <h2 id="exec-script">Executing scripts on update</h2>
    <p>
        To run JavaScript as part of an update (e.g. open a modal or trigger an animation),
        use <code>$c-&gt;execScript()</code> inside an action:
    </p>
    {% code 'php' %}{% verbatim %}
$c->action(function (Context $c) use ($msg): void {
    $msg->setValue('Saved!');
    $c->execScript('document.querySelector(".toast").classList.add("visible")');
    $c->sync();
}, 'save');
{% endverbatim %}{% endcode %}

    <h2 id="next-steps">Next steps</h2>
    <ul>
        <li><a href="/docs/signals">Signals</a>: state that drives view updates</li>
        <li><a href="/docs/actions">Actions</a>: triggers that cause re-renders</li>
        <li><a href="/docs/components">Components</a>: isolated views with their own signal scope</li>
        <li><a href="/docs/twig">Twig templates</a>: binding signals in templates</li>
    </ul>
</article>

{% endblock %}
