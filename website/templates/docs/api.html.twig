{% extends 'shells/docs.html.twig' %}
{% block title %}API Reference · php-via Docs{% endblock %}
{% block content %}
<article>
    <h1>API Reference</h1>
    <p>Complete reference for the php-via public API. Methods marked <code>@internal</code> may change between versions.</p>

    <h2 id="via">Via</h2>

    <h3 id="via-constructor"><code>new Via(Config $config)</code></h3>
    {% code 'php' %}{% verbatim %}
$app = new Via(
    (new Config())
        ->withHost('0.0.0.0')
        ->withPort(3000)
        ->withTemplateDir(__DIR__ . '/templates')
);
    {% endverbatim %}{% endcode %}

    <h3 id="via-page"><code>page(string $route, callable $handler): RouteDefinition</code></h3>
    <p>Register a page route. Path params use <code>{name}</code> syntax and are injected as typed arguments. Returns a <code>RouteDefinition</code> for fluent middleware registration.</p>
    {% code 'php' %}{% verbatim %}
$app->page('/', fn(Context $c) => $c->view('home.html.twig'));

$app->page('/users/{id}', function (Context $c, int $id): void {
    $c->view('user.html.twig', ['id' => $id]);
});

// With per-route middleware:
$app->page('/admin', fn(Context $c) => $c->view('admin.html.twig'))
    ->middleware(new AuthMiddleware());
    {% endverbatim %}{% endcode %}

    <h3 id="via-mount"><code>mount(string $class, string $route, ?callable $factory = null): RouteDefinition</code></h3>
    <p>
        Register a class as a page using the composition API. The class must have a public
        <code>view(Context $ctx): void</code> method. Reactive properties are declared with
        <code>#[Signal]</code> (optionally scoped, e.g. <code>#[Signal(Scope::SESSION)]</code>);
        server-only state with <code>#[Persist]</code>; action methods with <code>#[Action]</code>.
        Returns a <code>RouteDefinition</code> for fluent middleware chaining.
        See <a href="/docs/composition">Composition</a>.
    </p>
    {% code 'php' %}{% verbatim %}
// Zero-arg constructor (default):
$app->mount(Counter::class, '/counter');

// Factory (called once per connecting tab, receives no arguments):
$app->mount(
    ChatPage::class,
    '/chat/{room}',
    fn(): ChatPage => new ChatPage($db, $app)
);

// Middleware chain:
$app->mount(Dashboard::class, '/dashboard')
    ->middleware(new AuthMiddleware());
    {% endverbatim %}{% endcode %}

    <h3 id="via-middleware"><code>middleware(MiddlewareInterface ...$middleware): void</code></h3>
    <p>Register global PSR-15 middleware that runs on every page and action request. See <a href="/docs/middleware">Middleware</a>.</p>
    {% code 'php' %}{% verbatim %}
$app->middleware(new CorsMiddleware([...]));
    {% endverbatim %}{% endcode %}

    <h3 id="via-regenerate-session"><code>regenerateSession(ServerRequestInterface $request): void</code></h3>
    <p>
        <code>$c-&gt;regenerateSession()</code> for middleware and <code>route()</code> handlers: the response to
        <code>$request</code> sets a new session cookie. Middleware on a page calls it before
        <code>$handler-&gt;handle()</code>, which sends the page; afterwards it throws a <code>LogicException</code>.
    </p>
    {% code 'php' %}{% verbatim %}
$app->route('POST', '/login', new class($app) implements RequestHandlerInterface {
    public function __construct(private Via $app) {}

    public function handle(ServerRequestInterface $request): ResponseInterface {
        // ...check the credentials...
        $this->app->regenerateSession($request);
        $this->app->setSessionData($request->getAttribute('via.session'), 'user', $user);

        return new Response(303, ['Location' => '/dashboard']);
    }
});
    {% endverbatim %}{% endcode %}

    <h3 id="via-broadcast"><code>broadcast(string $scope): void</code></h3>
    <p>Push updates to all contexts in a scope. Use after modifying global state outside an action. A bare
    <code>Scope::ROUTE</code> reaches every context on every route, like <code>Scope::GLOBAL</code>; pass
    <code>Scope::routeScope('/path')</code> to target one route.</p>
    {% code 'php' %}{% verbatim %}
$app->broadcast(Scope::GLOBAL);
$app->broadcast(Scope::routeScope('/'));
$app->broadcast('room:lobby');
    {% endverbatim %}{% endcode %}
    <p>Inside a coroutine (actions, timers, SSE hooks, broker messages) the call only marks the scope. The
    worker's next flush re-renders it once and publishes it to other workers and nodes once, however many times
    it was broadcast in the meantime, so views show the state as it is then. That flush runs at the end of the
    current event-loop turn when the worker's last flush started at least one broadcast tick (25&nbsp;ms by
    default) ago and ended at least half a tick ago, otherwise as soon as both have passed. Outside a coroutine
    and while the worker shuts down, the call renders before it returns. See <a
    href="/docs/broadcasting#timing">Broadcasting → When the update is sent</a>.</p>

    <h3 id="via-flush-broadcasts"><code>flushBroadcasts(): void</code></h3>
    <p>Run the broadcasts marked so far now, in the calling coroutine, without waiting for the tick. Use it when
    the fan-out has to reach clients before something queued after it, or before shared state is changed back.
    When another flush is rendering a scope this coroutine broadcast, it waits for that fan-out, at most one
    second; past that it logs a warning and returns, and that scope's frame follows on a later flush.</p>
    {% code 'php' %}{% verbatim %}
$app->broadcast('room:lobby');
$app->flushBroadcasts();
$c->execScript('scrollToBottom()'); // arrives after the new messages
    {% endverbatim %}{% endcode %}

    <h3 id="via-global-state"><code>globalState(string $key, mixed $default = null): mixed</code></h3>
    <h3 id="via-set-global-state"><code>setGlobalState(string $key, mixed $value): void</code></h3>
    <p>Shared in-memory state across all contexts. Lives for the server lifetime and is cleared on restart,
    unless <a href="#config"><code>withPersistentGlobalState()</code></a> is set.</p>
    {% code 'php' %}{% verbatim %}
$app->setGlobalState('counter', 0);
$count = $app->globalState('counter', 0);
    {% endverbatim %}{% endcode %}
    <p>
        Keys are at most 63 characters once GlobalState is in shared memory (<code>worker_num &gt; 1</code> or
        persistence on); a longer key throws <code>\InvalidArgumentException</code>.
    </p>

    <h3 id="via-increment-global-state"><code>incrementGlobalState(string $key, int $by = 1): int</code></h3>
    <h3 id="via-mutate-global-state"><code>mutateGlobalState(string $key, callable $mutator): mixed</code></h3>
    <p>
        Read-modify-write without losing updates. <code>setGlobalState($k, globalState($k) + 1)</code> is two
        steps, and with several workers two of them can read the same value: over 4 workers doing 500
        increments each it kept 772 to 1238 of 2000. <code>incrementGlobalState()</code> is atomic and returns
        the new value; it throws <code>\LogicException</code> if the key holds a non-integer.
        <code>mutateGlobalState()</code> passes the current value (<code>null</code> if unset) to the callback
        under a lock on the key and stores what it returns, so keep the callback short and non-blocking.
    </p>
    {% code 'php' %}{% verbatim %}
$app->incrementGlobalState('visits');
$app->mutateGlobalState('messages', fn (?array $msgs) => array_slice([...$msgs ?? [], $msg], -50));
    {% endverbatim %}{% endcode %}

    <h3 id="via-on-start"><code>onWorkerStart(callable $callback): void</code></h3>
    <h3 id="via-on-shutdown"><code>onWorkerStop(callable $callback): void</code></h3>
    <p>Server lifecycle hooks. Use <code>onStart</code> to create timers; <code>onShutdown</code> to clear them.
    <code>onStart</code> callbacks run once in each worker process as it starts, so with <code>worker_num &gt; 1</code>
    a timer created there fires in every worker. Use <a href="#via-set-interval"><code>setInterval()</code></a>
    for a timer that should fire once per interval for the whole server.</p>
    <p>
        <code>onShutdown</code> callbacks run once in each worker process when that worker stops: on
        <code>SIGTERM</code> or <code>SIGINT</code> (<code>docker stop</code>, <code>systemctl stop</code>,
        Ctrl-C), and also when a worker is reloaded (<code>SIGUSR1</code>) or recycled after
        <code>max_request</code>. A callback cannot tell a reload from a stop. They run inside a coroutine. Before
        they run, the worker closes its SSE streams and waits up to half the stop budget for them to finish, so
        <code>onClientDisconnect</code> has normally run for each client by then. With <code>max_wait_time</code>
        below 2 there is no wait. A callback that throws is logged and the rest still run.
        OpenSwoole's <code>max_wait_time</code> (3 seconds by default) bounds the whole stop, and because it counts
        whole seconds the real budget is roughly <code>max_wait_time</code> minus up to one second.
    </p>
    <p>
        End long-lived coroutines, sockets and <code>Event::add</code> fds from <code>onShutdown</code>, or have
        background loops check <code>$app-&gt;isShuttingDown()</code>. Anything still alive holds the worker until
        <code>max_wait_time</code>, and then OpenSwoole kills it. The worker logs a warning with the number of
        coroutines left.
    </p>
    {% code 'php' %}{% verbatim %}
$timerId = null;
$app->onWorkerStart(function (int $workerId) use ($app, &$timerId): void {
    $timerId = Timer::tick(5000, fn() => $app->broadcast(Scope::GLOBAL));
});
$app->onWorkerStop(function (int $workerId) use (&$timerId): void {
    if ($timerId !== null) Timer::clear($timerId);
});
    {% endverbatim %}{% endcode %}

    <h3 id="via-set-interval"><code>setInterval(callable $callback, int $ms, bool $everyWorker = false): void</code></h3>
    <p>
        Register a server-wide recurring timer that fires every <code>$ms</code> milliseconds.
        It is armed when the worker starts and cleared when it stops, with no manual
        <code>onStart</code>/<code>onShutdown</code> wiring. With <code>worker_num &gt; 1</code> it runs on one
        worker only, so the callback fires once per interval for the whole server. Pass
        <code>everyWorker: true</code> for work that has to happen in each process.
    </p>
    {% code 'php' %}{% verbatim %}
// Broadcast global state every 5 seconds
$app->setInterval(fn() => $app->broadcast(Scope::GLOBAL), 5000);
    {% endverbatim %}{% endcode %}

    <h3 id="via-get-scoped-signal-by-name"><code>getScopedSignalByName(string $scope, string $name, ?string $namespace = null): ?Signal</code></h3>
    <p>
        Find a scoped signal from code that runs outside a context, such as a timer. Pass the name the signal
        was declared with, not its browser id, and a resolved scope: <code>Scope::routeScope('/path')</code>
        rather than <code>Scope::ROUTE</code>. For a signal declared inside a component, also pass the
        component's namespace. It returns <code>null</code> until a context on this worker has declared the signal.
    </p>
    {% code 'php' %}{% verbatim %}
$app->setInterval(function () use ($app): void {
    $app->getScopedSignalByName('room:lobby', 'topic')?->setValue('Lunch');
}, 5000);
    {% endverbatim %}{% endcode %}

    <h3 id="via-group"><code>group(callable $fn): RouteGroup</code></h3>
    <p>
        Register multiple routes inside a closure and attach shared middleware to all of them in one call.
        Returns a <code>RouteGroup</code> with a fluent <code>middleware()</code> method.
        Only routes registered <em>inside</em> the closure are included.
    </p>
    {% code 'php' %}{% verbatim %}
use Mbolli\PhpVia\Http\RouteGroup;

$app->group(function (Via $app): void {
    $app->page('/admin', fn(Context $c) => ...);
    $app->page('/admin/users', fn(Context $c) => ...);
})->middleware(new AuthMiddleware());
    {% endverbatim %}{% endcode %}

    <h3 id="via-on-client-connect"><code>onClientConnect(callable $callback): void</code></h3>
    <h3 id="via-on-client-disconnect"><code>onClientDisconnect(callable $callback): void</code></h3>
    <p>
        Fire when a client opens or closes an SSE connection. The callback receives the client's <code>Context</code>.
        On disconnect, the client has already been removed from <code>getClients()</code>.
        See <a href="/docs/lifecycle">Lifecycle</a> for usage.
    </p>
    {% code 'php' %}{% verbatim %}
$app->onClientConnect(fn(Context $c) => $app->broadcast(Scope::routeScope($c->getRoute())));
$app->onClientDisconnect(fn(Context $c) => $app->broadcast(Scope::routeScope($c->getRoute())));
    {% endverbatim %}{% endcode %}

    <h3 id="via-get-clients"><code>getClients(): array</code></h3>
    <p>
        With several workers the list covers every worker. A broadcast reads it once for all the views it renders,
        unless a client connects or leaves on this worker, or other code on this worker reads the list while a view
        waits on I/O.
    </p>
    {% code 'php' %}{% verbatim %}
$clients = $app->getClients();
// ['contextId' => ['id' => '...', 'identicon' => '<svg ...>', 'connected_at' => 1234567890, 'ip' => '...', 'context_id' => 'contextId']]
$count = count($app->getClients());
    {% endverbatim %}{% endcode %}

    <h3 id="via-append-to-head"><code>appendToHead(string ...$elements): void</code></h3>
    {% code 'php' %}{% verbatim %}
$c->appendToHead(
    '<title>My Page</title>',
    '<meta name="description" content="...">'
);
    {% endverbatim %}{% endcode %}
    <p>
        <code>$app-&gt;appendToHead()</code> adds to every page, <code>$c-&gt;appendToHead()</code> to one
        context; <code>appendToFoot()</code> works the same before <code>&lt;/body&gt;</code>. With a shell
        they fill <code>{% verbatim %}{{ head_content }}{% endverbatim %}</code> and
        <code>{% verbatim %}{{ foot_content }}{% endverbatim %}</code>. A view that renders a full
        <code>&lt;html&gt;</code> document gets them before its first <code>&lt;/head&gt;</code> and last
        <code>&lt;/body&gt;</code>, on the initial render and on every SSE update, unless the exact markup
        is already there. Such a document also gets, right after its opening <code>&lt;head&gt;</code>,
        a <code>via_ctx</code> meta when it has none and a <code>data-signals__ifmissing</code> seed of
        the initial signal values, but never the SSE
        bootstrap or <code>datastar.js</code>: the layout has to carry those. A <code>&lt;title&gt;</code>
        appended here lands next to the layout's own. See <a href="/docs/twig#twig-shell">Templates</a>.
    </p>

    <h3 id="via-get-twig"><code>getTwig(): Twig\Environment</code></h3>
    {% code 'php' %}{% verbatim %}
$app->getTwig()->addExtension(new MyExtension());
    {% endverbatim %}{% endcode %}

    <h3 id="via-log"><code>log(string $level, string $message, ?Context $context = null): void</code></h3>
    {% code 'php' %}{% verbatim %}
$app->log('info', 'Server ready');
$app->log('debug', 'Action fired', $c);
    {% endverbatim %}{% endcode %}

    <h3 id="via-start"><code>start(): void</code></h3>
    <p>Start the OpenSwoole server. Call this last, after all routes are registered.</p>

    <h3 id="via-hook-flags"><code>Via::defaultHookFlags(): int</code> and <code>Via::noFileIoHookFlags(): int</code></h3>
    <p>
        <code>defaultHookFlags()</code> returns the <code>hook_flags</code> php-via sets:
        <code>SWOOLE_HOOK_ALL</code>, without <code>SWOOLE_HOOK_NATIVE_CURL</code> when libcurl is 8.20 or
        newer. <code>HOOK_FLAGS_NO_FILE_IO</code> is the socket, stream, sleep and <code>proc_open()</code>
        hooks, without file and stdio I/O and without native curl, 1790 on OpenSwoole 26.2, for apps that run
        no shell commands and hold no file lock across a suspension. See
        <a href="/docs/deployment#hooks-narrow">Deployment → Coroutine hooks</a>.
    </p>
    {% code 'php' %}{% verbatim %}
$config->withSwooleSettings(['hook_flags' => Via::noFileIoHookFlags()]);
    {% endverbatim %}{% endcode %}

    ---

    <h2 id="context">Context</h2>
    <p>One context per connected browser tab. Holds signals, actions, and view definition for that client.</p>

    <h3 id="context-signal"><code>signal(mixed $initial, string $name, ?string $scope, bool $autoBroadcast, ?bool $clientWritable)</code></h3>
    {% code 'php' %}{% verbatim %}
$count  = $c->signal(0, 'count');                   // TAB scope
$shared = $c->signal(0, 'count', Scope::ROUTE);     // shared across route
$pref   = $c->signal('light', 'theme', Scope::SESSION);
$room   = $c->signal('', 'note', 'room:lobby');     // custom scope

// Collaborative: allow clients to write to a scoped signal
$input  = $c->signal('', 'note', Scope::ROUTE, clientWritable: true);

// Server-owned TAB signal: the value the browser posts is ignored
$status = $c->signal('idle', 'status', clientWritable: false);
    {% endverbatim %}{% endcode %}
    <p>
        Datastar posts every signal the browser holds with each action, and php-via writes the
        values into the signals before the action runs. <code>clientWritable</code> decides which
        signals take them:
    </p>
    <ul>
        <li><code>null</code> (default): TAB signals take the client value, scoped signals are
            <strong>server-authoritative</strong>, so clients cannot overwrite shared state.</li>
        <li><code>true</code>: the signal takes the client value in any scope. Use it for
            collaborative inputs where several clients push values, e.g. a shared text field with
            <code>data-bind</code>.</li>
        <li><code>false</code>: the signal ignores the client value in any scope. When the posted
            value differs, the server value is sent back with the next sync.</li>
    </ul>
    <p>
        <code>Config::withStrictTabSignals()</code> turns the TAB default into server-owned, so only
        TAB signals declared <code>clientWritable: true</code> take client values. Before switching it
        on, check which signals the page binds or assigns in the browser. The composition API takes
        the same argument: <code>#[Signal(clientWritable: false)]</code>. Signals declared inside a
        component follow the same rules.
    </p>
    <p>
        A server-owned TAB signal lives in the worker that holds the context. With
        <code>worker_num &gt; 1</code>, an action that lands on another worker rebuilds the context
        there, and the signal starts from its initial value, so each worker keeps its own copy. Use
        <code>worker_num = 1</code> for such pages, or keep the value in a scoped signal, which is
        shared across workers.
    </p>
    <p>
        Every signal gets an id that is unique per tab: the browser uses it in <code>data-bind</code>,
        <code>$name</code> expressions and the patches it receives. A scoped signal outside a component
        whose name is letters and digits, in a scope of letters and digits joined by <code>:</code> or a
        route path of letters and digits, keeps a readable id such as <code>global_count</code> or
        <code>route__examples_counter_count</code>. Every other id, which includes all TAB and component
        signals, ends in <code>____</code> plus one code per <code>_</code> saying what it stands for, so
        two names that differ only in punctuation never share an id. Use <code>$signal-&gt;id()</code>,
        <code>bind()</code> and <code>text()</code> in templates instead of writing ids by hand, and
        <code>$app-&gt;getScopedSignalByName()</code> to find a scoped signal from code outside a context.
    </p>
    <p>
        Declaring a TAB signal again with the same name returns the existing signal and sets it to the
        new initial value. When that changes the live value, or the declaration asks for a different
        <code>clientWritable</code> (the first one is kept), php-via logs a warning once per name. The
        warning gives the type and size of both values, not their content.
    </p>

    <h3 id="context-action"><code>action(callable $fn, ?string $name = null): Action</code></h3>
    <p>
        The action is the context's own and runs for the tab that posts it, whatever scope the context
        joined. A third argument throws: the <code>$scope</code> parameter was removed in 0.14. Inside a
        component, the action reads the page's request through <code>$c->input()</code>,
        <code>$c->file()</code> and <code>$c->cookie()</code>.
    </p>
    {% code 'php' %}{% verbatim %}
$inc = $c->action(function (Context $c) use ($count): void {
    $count->setValue($count->int() + 1);
    $c->sync();
}, 'increment');

// In Twig: data-on:click="@post('/_action/increment')"
    {% endverbatim %}{% endcode %}
    <p>
        Registering an action with the same name again replaces the earlier callback, and php-via
        logs a warning once per action id.
    </p>

    <h3 id="context-view"><code>view(callable|string $view, array|callable $data = [], ?string $block = null, bool $shareRender = false): void</code></h3>
    <p>
        Signals and actions registered on the context are <strong>auto-injected</strong> into every Twig render
        as named variables (signal baseName, action camelCase name). Entries in <code>$data</code> take priority.
    </p>
    {% code 'php' %}{% verbatim %}
// count and increment are auto-injected: no explicit passing needed
$c->view('counter.html.twig');

// Only pass data that isn't a signal/action:
$c->view('todo.html.twig', ['todos' => $todos]);

$c->view(fn() => "<p>Count: {$count->int()}</p>");

// Send only {% block demo %} on SSE updates (full template on initial load):
$c->view('todo.html.twig', ['todos' => $todos], block: 'demo');

// Data read again on every render, for views that read external state:
$c->view('presence.html.twig', fn (): array => ['n' => count($app->getClients())]);

// One render per broadcast for every tab in the primary scope (the view must be the same for all of them):
$c->view('board.html.twig', fn (): array => ['cells' => $board->cells()], shareRender: true);
    {% endverbatim %}{% endcode %}

    <h3 id="context-component"><code>component(callable|string $fn, string $namespace): callable</code></h3>
    <p>
        Create a reusable sub-context. Pass a callable for the closure API or a class name string for
        the composition API: the class is analyzed once and its setup closure built automatically.
        See <a href="/docs/components">Components</a> and <a href="/docs/composition">Composition</a>.
    </p>
    {% code 'php' %}{% verbatim %}
// Closure form:
$counter = $c->component(function (Context $c): void {
    $n   = $c->signal(0, 'n');
    $inc = $c->action(fn() => $n->setValue($n->int() + 1), 'inc');
    $c->view('counter.html.twig');
}, 'counter');

// Class form (composition API):
$counter = $c->component(Counter::class, 'counter');

$c->view(fn (): string => $c->render('page.html.twig', ['counter' => $counter()]));
    {% endverbatim %}{% endcode %}

    <h3 id="context-get-signal"><code>getSignal(string $name): ?Signal</code></h3>
    <h3 id="context-get-action"><code>getAction(string $name): ?Action</code></h3>
    <p>Retrieve a registered signal or action by name after registration. Useful in actions that need to look up signals by name rather than via a captured variable.</p>
    {% code 'php' %}{% verbatim %}
$c->getSignal('count');    // returns the Signal registered as 'count', or null
$c->getAction('increment'); // returns the Action registered as 'increment', or null
    {% endverbatim %}{% endcode %}

    <h3 id="context-scope"><code>scope(string $scope): void</code></h3>
    <h3 id="context-add-scope"><code>addScope(string $scope): void</code></h3>
    {% code 'php' %}{% verbatim %}
$c->scope(Scope::ROUTE);          // set primary scope
$c->addScope('room:' . $roomId);  // add additional scope
    {% endverbatim %}{% endcode %}

    <h3 id="context-sync"><code>sync(): void</code></h3>
    <h3 id="context-sync-signals"><code>syncSignals(): void</code></h3>
    <p><code>sync()</code> re-renders the view and pushes signals. <code>syncSignals()</code> pushes only signals, skipping view re-render.</p>

    <h3 id="context-broadcast"><code>broadcast(): void</code></h3>
    <p>Broadcast to all contexts in this context's primary scope. Same timing as
    <a href="#via-broadcast"><code>$app-&gt;broadcast()</code></a>.</p>

    <h3 id="context-exec-script"><code>execScript(string $script): void</code></h3>
    {% code 'php' %}{% verbatim %}
$c->execScript('document.querySelector(".flash").classList.add("show")');
    {% endverbatim %}{% endcode %}

    <h3 id="context-set-interval"><code>setInterval(callable $callback, int $ms): int</code></h3>
    <p>Recurring timer, auto-cancelled when the context is destroyed.</p>
    {% code 'php' %}{% verbatim %}
$c->setInterval(function () use ($count, $c): void {
    $count->setValue($count->int() + 1);
    $c->sync();
}, 1000);
    {% endverbatim %}{% endcode %}

    <h3 id="context-on-cleanup"><code>onCleanup(callable $callback): void</code></h3>
    <p>Per-context disconnect hook for cleaning up resources. <code>onCleanup</code> is an alias. See <a href="/docs/lifecycle">Lifecycle</a>.</p>
    {% code 'php' %}{% verbatim %}
$c->onCleanup(function (Context $c) use ($room, $app): void {
    unset(Room::$members[$room][$c->getId()]);
    $app->broadcast('room:' . $room);
});
    {% endverbatim %}{% endcode %}

    <h3 id="context-cookies"><code>cookie(string $name): ?string</code></h3>
    <h3><code>setCookie(string $name, string $value, int $expires = 0, string $path = '/', bool $httpOnly = true, bool $secure = true, string $sameSite = 'Lax'): void</code></h3>
    <h3><code>deleteCookie(string $name, string $path = '/'): void</code></h3>
    <p>Coroutine-safe cookie access. <code>cookie()</code> reads a cookie of the request the code serves (replaces <code>$_COOKIE</code>, which is unsafe in OpenSwoole). <code>setCookie()</code> queues a cookie for that request's response with secure defaults. <code>deleteCookie()</code> expires a cookie immediately. A cookie set in the page handler goes out with the page, one set in an action with that action's response, and one set outside a request, such as in a timer, with the tab's next action response. See <a href="/docs/actions#action-request">Each action reads its own request</a>.</p>
    {% code 'php' %}{% verbatim %}
$theme = $c->cookie('theme');        // null if not set
$c->setCookie('theme', 'dark');      // Secure, HttpOnly, SameSite=Lax by default
$c->deleteCookie('theme');           // expires cookie immediately
    {% endverbatim %}{% endcode %}

    <h3 id="context-file"><code>file(string $name): ?array</code></h3>
    <p>Read a file from the multipart form upload of the action request. Returns the upload array (<code>name</code>, <code>type</code>, <code>tmp_name</code>, <code>size</code>) or <code>null</code> if the field is missing or errored, outside an action, and once the action has answered, because OpenSwoole then deletes the temporary file. Use Datastar's <code>contentType: 'form'</code> modifier to submit the form as a real multipart POST.</p>
    {% code 'php' %}{% verbatim %}
$upload = $c->file('avatar');
if ($upload !== null) {
    move_uploaded_file($upload['tmp_name'], '/uploads/' . basename($upload['name']));
}
    {% endverbatim %}{% endcode %}

    <h3 id="context-getters">Getters</h3>
    {% code 'php' %}{% verbatim %}
$c->getId();              // unique context ID
$c->getRoute();           // current route, e.g. '/chat/lobby'
$c->getSessionId();       // session ID shared across tabs
$c->getPathParam('id');   // path parameter by name
$c->getNamespace();       // component namespace, or null
    {% endverbatim %}{% endcode %}

    <h3 id="context-session-data"><code>sessionData(string $key, mixed $default = null): mixed</code></h3>
    <h3 id="context-set-session-data"><code>setSessionData(string $key, mixed $value): void</code></h3>
    <h3 id="context-clear-session-data"><code>clearSessionData(?string $key = null): void</code></h3>
    <p>Per-session server-side storage, keyed on the session id. Survives page refreshes, context destruction and <code>regenerateSession()</code>, unlike signals, which reset on refresh.</p>
    <p>
        With <code>worker_num &gt; 1</code> session data lives in shared memory, so every worker sees it.
        Values are serialized there: they must be serializable (<code>setSessionData()</code> throws
        <code>\InvalidArgumentException</code> otherwise), an object comes back as a copy, and one
        session's data is capped at 16&nbsp;KB by default, past which <code>setSessionData()</code> throws
        <code>\OverflowException</code>. <code>Config::withSessionTableSize()</code> raises the cap and the
        number of sessions kept. Each key is last-write-wins, so reading a key and writing it back from two
        workers at once can lose one of the writes.
    </p>
    {% code 'php' %}{% verbatim %}
$c->setSessionData('auth', ['user' => 'ada', 'role' => 'Engineer']);

$auth = $c->sessionData('auth');       // returns the array or null

$c->clearSessionData('auth');          // clear one key
$c->clearSessionData();                // clear entire session bucket
    {% endverbatim %}{% endcode %}

    <h3 id="context-regenerate-session"><code>regenerateSession(): void</code></h3>
    <p>
        Gives the session a new cookie with the response to the current action or page load. Call it at login, so a
        cookie someone planted or read before no longer reaches the session, and at logout with
        <code>clearSessionData()</code>. The session keeps its id, its data, its SESSION signals and its other tabs.
    </p>
    <p>
        The old cookie keeps working for 10 seconds, for the requests other tabs sent before the browser had the new
        one, and then starts a new session. Called outside an action or a page handler, the rotation waits for the
        tab's next action. Middleware and <code>route()</code> handlers use
        <a href="#via-regenerate-session"><code>$app-&gt;regenerateSession($request)</code></a>.
    </p>
    <p>
        The record of retired cookies lives in memory, one per server. After a restart the first cookie of a
        rotated session names that session id again, and its current cookie names a new one. Session data is gone
        after a restart anyway; data you keep elsewhere belongs under the user's id, not under
        <code>getSessionId()</code>. Behind a load balancer, route by the balancer's own cookie, as the
        <a href="/docs/deployment#independent-processes">deployment guide</a> does, since the session cookie changes.
    </p>
    {% code 'php' %}{% verbatim %}
$c->action(function (Context $c) use ($email, $password, $users): void {
    $user = $users->check($email->string(), $password->string());
    if ($user === null) {
        return;
    }
    $c->regenerateSession();
    $c->setSessionData('user', $user->id);
}, 'login');
    {% endverbatim %}{% endcode %}

    <h3 id="context-input"><code>input(string $name, mixed $default = null): mixed</code></h3>
    <p>Read a query or POST parameter safely. Checks POST first, then query string. Replaces direct <code>$_GET</code>/<code>$_POST</code> access (which is coroutine-unsafe in OpenSwoole). In an action, and in the <code>spawn()</code> tasks it starts, it reads the action's request; anywhere else, such as the page handler or a timer, the page's query.</p>
    {% code 'php' %}{% verbatim %}
$id = $c->input('id');                  // POST['id'] ?? GET['id'] ?? null
$cat = $c->input('cat', 'all');         // with default
    {% endverbatim %}{% endcode %}

    <h3 id="context-request-attributes"><code>getRequestAttribute(string $name, mixed $default = null): mixed</code></h3>
    <p>Read a request attribute set by PSR-15 middleware: in an action, one the global middleware set on that action's request; anywhere else, one of the page request. See <a href="/docs/middleware#request-attributes">Middleware</a>.</p>
    {% code 'php' %}{% verbatim %}
$user = $c->getRequestAttribute('user');  // set by AuthMiddleware
    {% endverbatim %}{% endcode %}

    ---

    <h2 id="signal">Signal</h2>
    {% code 'php' %}{% verbatim %}
// Reading
$s->getValue();   // raw mixed
$s->int();        // cast to int
$s->string();     // cast to string
$s->bool();       // cast to bool

// Writing
$s->setValue(42); // triggers broadcast if scoped
$s->increment();  // atomic across workers, returns the new value
$s->mutate(fn (array $items) => [...$items, $item]); // read-modify-write under a lock

// Template helpers
$s->id();     // browser id, not the name: 'global_count' for a GLOBAL signal 'count'
$s->bind();   // 'data-bind="global_count"'
$s->bind('value');  // 'data-bind__prop.value="global_count"': binds a property, for web components
$s->ref();    // '$global_count', for Datastar expressions: data-text="{$s->ref()}"
    {% endverbatim %}{% endcode %}
    <p>
        <code>bind(?string $prop = null)</code> with a property name binds that element property
        instead of the element's value. A camelCase name is written in kebab case
        (<code>'selectedIndex'</code> becomes <code>data-bind__prop.selected-index</code>), and a name
        that is not a property name throws <code>\InvalidArgumentException</code>. In Twig:
        {% verbatim %}<code>{{ bind(volume, 'value') }}</code>{% endverbatim %}. See
        <a href="/docs/web-components#binding">Web components</a>.
    </p>
    <p>
        On a scoped signal with <code>worker_num &gt; 1</code>, <code>setValue($s-&gt;int() + 1)</code> loses
        updates when two workers read the same value. Use <code>increment()</code> for counters and
        <code>mutate()</code> for anything else. Pick one per signal: <code>increment()</code> skips the lock
        that <code>mutate()</code> takes, so mixing them can overwrite an increment. A broadcast reads each scoped
        signal once and reuses the value for every tab it renders, so this applies to views as well: a view that
        computes a new value from a scoped signal computes it from the value the broadcast read.
    </p>
    <p>
        Concurrent <code>mutate()</code> calls on one key run in order within a worker and take turns across
        workers. A call waits up to 2&nbsp;s behind earlier calls of its own worker and up to 5&nbsp;s for
        its turn, then throws <code>\RuntimeException</code>. A holder that keeps the lock longer than its
        2&nbsp;s lease, or a worker that is next in line but cannot run for 2&nbsp;s, is skipped, and the
        skipped write can overlap the next one. While calls queue, each waiting worker keeps one core busy
        polling, so keep callbacks short. <code>mutateGlobalState()</code> uses the same lock.
    </p>

    ---

    <h2 id="action">Action</h2>
    {% code 'php' %}{% verbatim %}
$a->url();  // '/_action/increment'
$a->id();   // 'increment'
    {% endverbatim %}{% endcode %}

    ---

    <h2 id="scope">Scope</h2>
    {% code 'php' %}{% verbatim %}
Scope::TAB      // default, per browser tab
Scope::ROUTE    // all clients on same URL
Scope::SESSION  // all tabs of same user
Scope::GLOBAL   // every connected client

Scope::routeScope('/path')  // explicit: 'route:/path'
    {% endverbatim %}{% endcode %}

    ---

    <h2 id="config">Config</h2>
    <p>All methods return <code>self</code> for chaining.</p>
    {% code 'php' %}{% verbatim %}
(new Config())
    ->withHost('0.0.0.0')           // default: '0.0.0.0'
    ->withPort(3000)                // default: 3000
    ->withDevMode(true)             // enables debug logging
    ->withLogLevel('info')          // 'debug' | 'info' | 'error'
    ->withTemplateDir(__DIR__ . '/templates')
    ->withShellTemplate(__DIR__ . '/shell.html')
    ->withStaticDir(__DIR__ . '/public')  // dot paths (but /.well-known/) and PHP sources (.php, .php5, .phtml, .inc, ...) answer 404
    ->withStaticCacheControl('public, max-age=31536000, immutable')  // default: devMode ? 'no-cache' : 'public, max-age=3600, must-revalidate'
    // ...or a closure(string $filePath, string $mimeType): string to fine-tune per file (see Deployment → Static assets)
    ->withBasePath('/')             // base path when mounted at a sub-path (see below)
    ->withDatastarRocket()          // serve Datastar with Rocket for web components (see below)
    ->withImportMap(['charts' => '/js/charts.js'], ['/js/charts.js' => 'sha384-...'])  // import map entries, merged across calls
    ->withSseKeepAliveMs(15000)     // SSE comment on a stream silent this long; 0 = none (default 15000)
    ->withContextTimeouts(connectMs: 30_000, reconnectMs: 60_000) // free a context whose SSE stream never connects; keep a tab whose stream is down after an action (defaults shown, see Lifecycle)
    ->withSwooleSettings([...])     // raw OpenSwoole server settings, e.g. ['hook_flags' => Via::noFileIoHookFlags()]
    // Security
    ->withSecureCookie(true)        // __Host- prefix, Secure flag
    ->withTrustedOrigins(['https://example.com'])  // CSRF origin allowlist
    ->withAllowMissingOrigin()      // accept actions without an Origin header outside dev mode
    ->withStrictTabSignals()        // TAB signals are server-owned unless clientWritable: true
    ->withEmbeddable('https://parent.example')  // SameSite=None; Secure; Partitioned + frame-ancestors
    ->withActionRateLimit(100, 60)  // max 100 actions per 60s per IP
    // HTTPS / HTTP2 / Brotli compression (requires ext-brotli)
    ->withCertificate('/path/to/cert.pem', '/path/to/key.pem') // direct TLS + HTTP/2
    ->withH2c()                     // h2c (cleartext HTTP/2) for proxy scenarios
    ->withBrotli()                  // Brotli for pages and SSE; withBrotli(dynamicLevel: 4, staticLevel: 11)
    ->withBrotli(false)             // no Brotli at all; withBrotli(false, staticLevel: 11) for static files only
    ->withSseMaxQueuedBytes(1048576) // drop element patches for a client this far behind; 0 disables
    ->withBroadcastTickMs(25)       // minimum gap between two broadcast flushes of a worker; 0 = every event-loop turn
    ->withBroadcastCoalescing(false) // render and publish on every broadcast() call; a fan-out re-run 8 times in a row leaves the rest to a flush paced by the tick (default: coalesced)
    // Multi-worker (single machine)
    ->withWorkerNum(swoole_cpu_num())   // default: 1; requires SwooleBroker/RedisBroker/NatsBroker when > 1
    ->withGlobalStateTableSize(2048, 65536)   // GlobalState rows × value bytes (default 1024 × 32768; rows is a floor)
    ->withScopedSignalTableSize(1024, 32768)  // shared values of scoped signals (defaults shown)
    ->withContextDirectorySize(4096)          // contexts reachable from every worker; see Deployment for sizing
    ->withSessionTableSize(1024, 16384)       // sessions × bytes per session of shared session data (defaults shown)
    // GlobalState persistence
    ->withPersistentGlobalState(__DIR__ . '/state.sqlite', flushMs: 1000) // write-behind to SQLite
    // Multi-node broker (optional, required only for multi-worker / multi-server deployments)
    ->withBroker(new SwooleBroker())    // same machine, no external deps
    ->withBroker(new RedisBroker('127.0.0.1', 6379))  // or new NatsBroker(...)
    ->onBrokerError(fn(\Throwable $e) => error_log($e->getMessage())) // called on reconnect
    {% endverbatim %}{% endcode %}

    <p>
        <code>withBrotli(bool $enabled = true, int $dynamicLevel = 4, ?int $staticLevel = null)</code>: <code>$enabled</code>
        turns on Brotli for pages and the SSE stream at <code>$dynamicLevel</code>. That requires either
        <code>withCertificate()</code> (direct HTTPS) or <code>withH2c()</code> (proxy with Caddy/Nginx handling TLS),
        and <code>start()</code> throws if <code>ext-brotli</code> is missing or neither HTTPS mode is configured.
        See <a href="/docs/deployment#brotli">Deployment → Brotli</a> for setup guides.
    </p>
    <p>
        Static files get Brotli at level 11 whenever <code>ext-brotli</code> is loaded, also without a call to
        <code>withBrotli()</code>: compressible <code>withStaticDir()</code> files, <code>/datastar.js</code>,
        <code>/via.css</code> and the Dev Bar assets. A <code>.br</code> sidecar is sent even without the extension.
        <code>$staticLevel</code> sets the level and <code>0</code> turns it off; left out, it is 11, or 0 for
        <code>withBrotli(false)</code>. See
        <a href="/docs/deployment#static-compression">Deployment → Static compression</a>.
    </p>
    <p>
        <code>withSwooleSettings(array $settings)</code> passes settings to OpenSwoole's
        <code>Server::set()</code>, and they win over php-via's defaults. <code>hook_flags</code> defaults
        to <a href="#via-hook-flags"><code>Via::defaultHookFlags()</code></a>. <code>start()</code> throws
        <code>\RuntimeException</code> before it binds the port when <code>hook_flags</code> has
        <code>SWOOLE_HOOK_STDIO</code> without <code>SWOOLE_HOOK_FILE</code>, or lacks the socket hook a
        <code>RedisBroker</code> needs, or when <code>worker_num</code> differs from <code>withWorkerNum()</code>:
        php-via sets up its shared tables for <code>withWorkerNum()</code>, so pass the worker count there. It logs a
        warning when <code>hook_flags</code> keep <code>SWOOLE_HOOK_NATIVE_CURL</code>
        on libcurl 8.20 or newer. The thread pool limits (<code>aio_*</code>) are not server settings: set
        them with <code>OpenSwoole\Util::setAio()</code>. See
        <a href="/docs/deployment#hooks">Deployment → Coroutine hooks</a>.
    </p>
    <p>
        <code>withPersistentGlobalState(string $path, int $flushMs = 1000)</code> keeps GlobalState in a SQLite
        file across restarts. Reads never touch SQLite: writes go to shared memory and mark the key dirty, and one
        worker writes the dirty keys in a single transaction every <code>$flushMs</code>, about 1&nbsp;µs per key.
        Anything written since the last flush is lost if the process dies, so lower <code>$flushMs</code> to
        narrow that window. That worker also flushes when it stops, and the master writes a final flush after
        every worker has stopped. Integers keep their type in the snapshot, so <code>incrementGlobalState()</code>
        keeps working on a restored counter.
    </p>
    <p>
        <code>withEmbeddable(array|string|null $frameAncestors = null, bool $partitioned = true)</code> makes the
        app safe to embed in a cross-origin <code>&lt;iframe&gt;</code>: it sets the session cookie to
        <code>SameSite=None; Secure; Partitioned</code> (so the browser sends it inside a cross-site frame, which
        the SSE session-auth gate needs) and emits <code>Content-Security-Policy: frame-ancestors</code> when given
        origins. It implies <code>withSecureCookie(true)</code> and requires HTTPS or <code>withH2c()</code>;
        <code>start()</code> hard-errors otherwise. It is unrelated to <code>withTrustedOrigins()</code>.
        See <a href="/docs/deployment#security-embedding">Deployment → Embedding in a cross-origin iframe</a>.
    </p>
    <p>
        <code>withBasePath(string $basePath)</code> sets the URL prefix when the app is mounted at a sub-path
        (e.g. <code>example.com/myapp/</code>). The value must be a relative path such as <code>/</code>,
        <code>/myapp</code>, or <code>/sub/path</code>. An <code>\InvalidArgumentException</code> is thrown
        at startup for invalid inputs (absolute URLs, protocol-relative paths, etc.).
        The basePath is exposed to every Twig template as <code>{% verbatim %}{{ basePath }}{% endverbatim %}</code>.
        See <a href="/docs/deployment#sub-path">Deployment &rarr; Sub-path mounting</a> for a Caddy example.
    </p>
    <p>
        <code>withDatastarRocket(bool $enabled = true)</code> serves Starbase's build of Datastar 1.0.4
        with Rocket at <code>/datastar.js</code> instead of the plain Datastar 1.0.4 bundle, so Rocket web
        components work on the page. It costs 22&nbsp;KB with Brotli against 12&nbsp;KB.
        <code>isDatastarRocketEnabled()</code> reports the setting. <code>getDatastarUrl()</code> returns
        the URL pages load Datastar from: the base path, <code>datastar.js</code> and the first 10 hex
        digits of the served bundle's SHA-256 as <code>v</code>, such as
        <code>/datastar.js?v=727844adfc</code>. Twig templates get it
        as <code>{% verbatim %}{{ datastarUrl }}{% endverbatim %}</code> and custom shells as
        <code>{% verbatim %}{{ datastar_url }}{% endverbatim %}</code>.
        <code>getDatastarIntegrity(): string</code> returns the bundle's Subresource Integrity value
        (sha384), for pinning Datastar in the import map; it throws <code>\RuntimeException</code> if the
        bundle cannot be read.
    </p>
    <p>
        <code>withImportMap(array $imports, array $integrity = [])</code> adds entries to the page's import
        map: <code>$imports</code> maps module specifiers to URLs, <code>$integrity</code> module URLs to
        Subresource Integrity values. Calls merge, and a later entry for the same key wins. A URL has to be
        absolute or start with <code>/</code> (every page gets the same map, so <code>./</code> would
        resolve differently per route), a specifier ending in
        <code>/</code> needs a URL ending in <code>/</code>, and an integrity value is
        <code>sha256-</code>, <code>sha384-</code> or <code>sha512-</code> with the base64 digest; anything
        else throws <code>\InvalidArgumentException</code>, and so does an entry for
        <code>datastar</code>, which php-via maps to <code>getDatastarUrl()</code> itself.
        <code>getImportMap()</code> returns the whole map as an array, <code>datastar</code> first, and
        <code>getImportMapTag()</code> the <code>&lt;script type="importmap"&gt;</code> tag. php-via writes
        the map when <code>withDatastarRocket()</code> is on or <code>withImportMap()</code> added entries,
        and the tag is empty otherwise. The default shell writes it, custom shells get it as
        <code>{% verbatim %}{{ import_map }}{% endverbatim %}</code> and Twig templates as
        <code>{% verbatim %}{{ importMap }}{% endverbatim %}</code>.
        See <a href="/docs/web-components#own-modules">Web components</a>.
    </p>
    ---

    <h2 id="attributes">Attributes</h2>
    <p>PHP 8 attribute classes for the <a href="/docs/composition">composition API</a>. All live under
    <code>Mbolli\PhpVia\Attributes\</code>.</p>

    <h3 id="attr-signal"><code>#[Signal(string $scope = Scope::TAB, bool $atomic = false, ?bool $clientWritable = null)]</code></h3>
    <p>Target: property. Creates a reactive signal backed by the property's default value, synced to the
    browser and auto-injected into Twig by name. The scope is the first argument:</p>
    <ul>
        <li><code>Scope::TAB</code> (default): isolated per tab, client-writable via <code>data-bind</code></li>
        <li><code>Scope::ROUTE</code>: shared across all users on the same route</li>
        <li><code>Scope::SESSION</code>: shared across all tabs of one browser session</li>
        <li><code>Scope::GLOBAL</code>: shared across every connected user</li>
        <li>custom string: shared across all contexts in that scope (e.g. <code>"room:lobby"</code>)</li>
    </ul>
    <p>Non-TAB scopes are server-authoritative (the client cannot write them) and auto-broadcast to every
    context in the scope when the value changes. Component instances with the same property name get
    independent signal IDs when a namespace is set (e.g. <code>global_cats_votes____kn</code>, <code>global_dogs_votes____kn</code>).</p>
    {% code 'php' %}{% verbatim %}
use Mbolli\PhpVia\Attributes\Signal;
use Mbolli\PhpVia\Scope;

#[Signal]                       // TAB: private per tab, client-writable
public int $count = 0;

#[Signal(Scope::ROUTE)]         // shared across all users on this route
public int $sharedCounter = 0;

#[Signal(Scope::SESSION)]       // shared across the user's tabs
public string $username = 'Anonymous';

#[Signal(Scope::GLOBAL)]        // shared across all users
public int $totalClicks = 0;
    {% endverbatim %}{% endcode %}
    <p>
        <code>atomic: true</code> makes a shared integer property safe to change from several workers at once.
        The property is read before the action and written back after, so two workers running
        <code>++$this-&gt;votes</code> together would both write back the same result. With
        <code>atomic: true</code> the action's net change goes through <code>Signal::increment()</code>
        instead. The catch: assignment becomes an adjustment, so <code>$this-&gt;votes = 0</code> subtracts
        the current value rather than resetting it. To set a value, use
        <code>$ctx-&gt;getSignal('votes')-&gt;setValue(0)</code>. Integer properties only.
    </p>
    {% code 'php' %}{% verbatim %}
#[Signal(Scope::GLOBAL, atomic: true)]
public int $votes = 0;
    {% endverbatim %}{% endcode %}

    <h3 id="attr-persist"><code>#[Persist]</code></h3>
    <p>Target: property. Marks a plain server-only instance property. No signal is created; the value is
    never sent to the browser. Because the class instance lives for the tab connection lifetime, the value
    persists across all action calls. Use it for accumulators, flags, or route params stored in
    <code>view()</code>.</p>
    {% code 'php' %}{% verbatim %}
use Mbolli\PhpVia\Attributes\Persist;

#[Persist]
public int $multiplier = 1; // invisible to client, persists per tab
    {% endverbatim %}{% endcode %}

    <h3 id="attr-broadcast"><code>#[Broadcast(string $scope)]</code></h3>
    <p>Target: class. Sets the context's primary scope, the target of <code>$ctx->broadcast()</code>
    with no argument. Use it when an action mutates non-signal state (a static array, a DB row) and needs
    to re-render for everyone in the scope. It does <strong>not</strong> change the scope of
    <code>#[Signal]</code> properties: each signal keeps its own declared scope.</p>
    {% code 'php' %}{% verbatim %}
use Mbolli\PhpVia\Attributes\Broadcast;
use Mbolli\PhpVia\Scope;

#[Broadcast(Scope::ROUTE)]
final class TodoList {
    #[Signal]                  // still TAB-scoped, unaffected by #[Broadcast]
    public string $draft = '';

    #[Action]
    public function add(Context $ctx): void {
        self::$todos[] = $this->draft;
        $ctx->broadcast();     // reaches every context on this route
    }
}
    {% endverbatim %}{% endcode %}

    <h3 id="attr-action"><code>#[Action(name?: string, scope?: string)]</code></h3>
    <p>Target: method. Marks a public method as a client-callable action. The method must accept
    <code>Context $ctx</code> as its only parameter. The resolved name (method name by default, or
    <code>name:</code> if provided) is used as the action URL slug and Twig variable name.
    With <code>scope:</code>, one action serves the whole scope, and it runs on the instance of the tab that posts it.</p>
    {% code 'php' %}{% verbatim %}
use Mbolli\PhpVia\Attributes\Action;

#[Action]
public function increment(Context $ctx): void { }       // /_action/increment

#[Action(name: 'reset-tab')]
public function resetTab(Context $ctx): void { }        // /_action/reset-tab

#[Action(scope: Scope::SESSION)]
public function setTheme(Context $ctx): void { }        // session-scoped action
    {% endverbatim %}{% endcode %}

    <h3 id="attr-lifecycle"><code>#[OnCleanup]</code></h3>
    <p>Target: method. Registers the method as a cleanup handler (via <code>Context::onCleanup()</code>).
    The method receives the <code>Context</code>. Several methods may carry it and run in declaration
    order, after reactive properties are re-hydrated. <code>#[OnDisconnect]</code> was removed in 0.14
    and throws at mount.</p>
    {% code 'php' %}{% verbatim %}
use Mbolli\PhpVia\Attributes\OnCleanup;

#[OnCleanup]
public function leave(Context $ctx): void {
    --Room::$members[$this->room];
    $ctx->broadcast();
}
    {% endverbatim %}{% endcode %}

