{% extends 'shells/docs.html.twig' %}
{% block title %}Components · php-via Docs{% endblock %}
{% block content %}
<article>
    <h1>Components</h1>
    <p>
        Components are reusable UI blocks backed by their own sub-context. Each component has isolated signals, actions,
        and a view, but shares the parent connection. They're the building block for composable real-time UIs.
    </p>

    <h2 id="creating">Creating a component</h2>
    <p>Define a component as a callable that configures a <code>Context</code>:</p>
    {% code 'php' %}{% verbatim %}
$counterComponent = function (Context $c): void {
    $count = $c->signal(0, 'count');
    $inc   = $c->action(fn() => $count->setValue($count->int() + 1) & $c->sync(), 'inc');

    // count and inc are auto-injected into the template as Signal/Action objects
    $c->view('components/counter.html.twig');
};
{% endverbatim %}{% endcode %}

    <h2 id="mounting">Mounting a component</h2>
    <p>
        Mount a component inside a page handler via <code>$c-&gt;component()</code>, giving it a namespace to prevent
        signal ID collisions. The returned callable renders the component's current HTML. Call it inside the page's
        view closure, so every render of the page carries the component as it is now:
    </p>
    {% code 'php' %}{% verbatim %}
$app->page('/', function (Context $c) use ($counterComponent): void {
    $counter = $c->component($counterComponent, 'counter');

    $c->view(fn (): string => $c->render('pages/home.html.twig', [
        'counter' => $counter(), // rendered each time the page renders
    ]));
});
{% endverbatim %}{% endcode %}

    {% code 'html' %}{% verbatim %}
{# pages/home.html.twig #}
<main>
    <h1>Welcome</h1>
    {{ counter | raw }}
</main>
{% endverbatim %}{% endcode %}

    <p>
        The page view renders again on a broadcast that reaches the page, on a reconnect and on a revival. Passing
        <code>$counter()</code> to <code>$c-&gt;view('pages/home.html.twig', [...])</code> renders the component once,
        when the handler runs, so each of those renders would put the page-load HTML back. A component the page frame
        carries sends only its signals in that update, so rendering it with the page does not render it twice.
    </p>
    <p>
        Each component's wrapper id is unique to its tab, so the HTML of a page that embeds components differs per tab
        and must not come from the shared update cache: keep the page's primary scope at TAB, or pass
        <code>cacheUpdates: false</code> to <code>view()</code>.
    </p>

    <h2 id="namespacing">Namespacing</h2>
    <p>
        The namespace prefixes all signal and action IDs in the component. This lets you mount the same component
        multiple times on one page without signal conflicts:
    </p>
    {% code 'php' %}{% verbatim %}
$counterA = $c->component($counterComponent, 'counter-a');
$counterB = $c->component($counterComponent, 'counter-b');

// counter-a has signal ID 'counter_a_count____dn', action '/_action/counter-a-inc'
// counter-b has signal ID 'counter_b_count____dn', action '/_action/counter-b-inc'

$c->view(fn (): string => $c->render('page.html.twig', [
    'counterA' => $counterA(),
    'counterB' => $counterB(),
]));
{% endverbatim %}{% endcode %}

    <h2 id="scoped-components">Scoped components</h2>
    <p>
        Components can set their own scope, independent of the parent. The website's presence indicator
        is a component in a scope of its own, so a visitor arriving or leaving re-renders the indicators
        and nothing else:
    </p>
    {% code 'php' %}{% verbatim %}
$presenceComponent = function (Context $c) use ($app, $twig): void {
    $c->scope('site:presence'); // only presence indicators join this scope

    $c->view(function () use ($app, $twig): string {
        $count = count($app->getClients());

        return $twig->render('components/presence.html.twig', [
            'count'  => $count,
            'person' => $count === 1 ? 'person' : 'people',
        ]);
    });
};

$app->onClientConnect(fn () => $app->broadcast('site:presence'));
$app->onClientDisconnect(fn () => $app->broadcast('site:presence'));
{% endverbatim %}{% endcode %}
    <p>
        A broadcast to the page's scope re-renders every component on the page, so give a busy widget its
        own scope and broadcast to that. A component in a custom scope registers its actions with
        <code>Scope::TAB</code>: the page finds scoped actions through its own scopes, its route and
        <code>Scope::GLOBAL</code>, not through a component's custom scope. A component action reads the
        page's request (<code>$c->input()</code>, <code>$c->cookie()</code>) and broadcasts with
        <code>$app->broadcast()</code>:
    </p>
    {% code 'php' %}{% verbatim %}
$counterComponent = function (Context $c) use ($app): void {
    $c->scope('home:counter');
    $count = $c->signal(0, 'count');

    $c->action(function () use ($app, $count): void {
        $count->increment();
        $app->broadcast('home:counter');
    }, 'increment', Scope::TAB);

    $c->view('counter.html.twig');
};
{% endverbatim %}{% endcode %}

    <h2 id="lifecycle">Component lifecycle</h2>
    <p>
        Components follow the same lifecycle as contexts. They support <code>onDisconnect</code>,
        <code>setInterval</code>, and all other context methods:
    </p>
    {% code 'php' %}{% verbatim %}
$roomComponent = function (Context $c) use ($room, $app): void {
    $c->addScope('room:' . $room);
    // ... signals, view ...

    $c->onDisconnect(function (Context $c) use ($room, $app): void {
        Room::$members[$room]--;
        $app->broadcast('room:' . $room);
    });
};
{% endverbatim %}{% endcode %}

